---
import Base from '../layouts/Base.astro';
import PlaceCard from '../components/PlaceCard.astro';
import secrets from '../data/secrets.json';
import { getTranslations } from '../utils/i18n';
import type { Place } from '../types/place';

const lang = 'en';
const t = getTranslations(lang);
const secretPlaces = secrets as Place[];
---

<Base
  lang={lang}
  title={t['secrets.meta.title']}
  description={t['secrets.meta.description']}
  canonicalPath="/secrets"
  ogImage="/og/og-secrets.jpg"
  noindex={true}
>
  <main class="secrets-page">
    <div class="container">
      <header class="secrets-page__header">
        <span class="eyebrow">{t['secrets.eyebrow']}</span>
        <h1 set:html={t['secrets.title']} />
      </header>

      <div class="card-grid">
        {
          secretPlaces.map((place) => (
            <PlaceCard
              place={place}
              lang={lang}
              directionsLabel={t['map.directions']}
              whatsappLabel={t['services.cta']}
            />
          ))
        }
      </div>
    </div>
  </main>

  <script>
    import { trackCtaClick } from '../utils/analytics';

    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-track-cta]');
      if (!target) return;

      const placeId = target.dataset.placeId;
      const ctaType = target.dataset.ctaType;
      if (placeId && ctaType) trackCtaClick(placeId, ctaType);
    });
  </script>
</Base>

<style>
  .secrets-page {
    padding-block: 3rem 4rem;
    background: var(--cream);
    min-height: 70svh;
  }

  .secrets-page__header {
    margin-bottom: 2rem;
  }

  .secrets-page__header h1 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
  }
</style>
