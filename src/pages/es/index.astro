---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import GuideContent from '../../components/GuideContent.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../utils/i18n';

const lang = 'es';
const t = getTranslations(lang);
---

<Base
  lang={lang}
  title={t['meta.title']}
  description={t['meta.description']}
  canonicalPath="/es/"
  floatingWaMessage={t['wa.floating']}
  floatingWaLabel="WhatsApp Saladita Rentals"
>
  <Hero
    lang={lang}
    altPath="/"
    eyebrow={t['hero.eyebrow']}
    titleLine1={t['hero.titleLine1']}
    titleLine2={t['hero.titleLine2']}
    sub={t['hero.sub']}
    langLabel={t['nav.lang']}
    helpCta={t['hero.helpCta']}
    helpMessage={t['wa.floating']}
    updated={t['hero.updated']}
  />
  <GuideContent lang={lang} t={t} />
  <Footer lang={lang} shareLabel={t['footer.share']} tagline={t['footer.tagline']} />
</Base>
