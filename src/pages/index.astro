---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GuideContent from '../components/GuideContent.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../utils/i18n';

const lang = 'en';
const t = getTranslations(lang);
---

<Base
  lang={lang}
  title={t['meta.title']}
  description={t['meta.description']}
  canonicalPath="/"
  floatingWaMessage={t['wa.floating']}
  floatingWaLabel="WhatsApp Saladita Rentals"
>
  <Hero lang={lang} altPath={'/'} t={t} />
  <GuideContent lang={lang} t={t} />
  <Footer lang={lang} shareLabel={t['footer.share']} tagline={t['footer.tagline']} />
</Base>
