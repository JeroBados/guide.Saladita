---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/dm-sans';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/700.css';
import '../styles/global.css';
import '../styles/animations.css';
import { ClientRouter } from 'astro:transitions';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { buildJsonLd } from '../utils/seo';
import type { Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  noindex?: boolean;
  floatingWaMessage?: string;
  floatingWaLabel?: string;
  /** explicit alternate-language paths when slugs differ (e.g. /get-there ↔ /es/como-llegar) */
  enPath?: string;
  esPath?: string;
}

const {
  lang,
  title,
  description,
  canonicalPath,
  ogImage = '/og/og-default.jpg',
  noindex = false,
  floatingWaMessage,
  floatingWaLabel,
  enPath: enPathProp,
  esPath: esPathProp,
} = Astro.props;

const site = Astro.site ?? 'https://guide.lasaladitarentals.com';
const canonical = new URL(canonicalPath, site).href;
const ogUrl = canonical;
const ogImageUrl = new URL(ogImage, site).href;

const enPath = enPathProp ?? (canonicalPath.startsWith('/es') ? canonicalPath.replace(/^\/es/, '') || '/' : canonicalPath);
const esPath = esPathProp ?? (canonicalPath.startsWith('/es') ? canonicalPath : `/es${canonicalPath === '/' ? '/' : canonicalPath}`);

const enUrl = new URL(enPath, site).href;
const esUrl = new URL(esPath, site).href;

const jsonLd = buildJsonLd(lang);
// Set the real GA4 id here; the tag is skipped while it is a placeholder.
const gaId = 'G-XXXXXXXXXX';
const gaEnabled = !gaId.includes('XXXX');
const showFloatingWa = floatingWaMessage && floatingWaLabel;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saladita Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_MX' } />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_MX' : 'en_US' } />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      gaEnabled && (
        <>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        </>
      )
    }
    <meta name="theme-color" content="#f3ecdd" />

    <ClientRouter />
  </head>
  <body>
    <slot />
    {
      showFloatingWa && (
        <FloatingWhatsApp lang={lang} label={floatingWaLabel!} message={floatingWaMessage!} />
      )
    }

  </body>
</html>
