---
import { WA_CATALOG_URL, buildWhatsAppUrl } from '../utils/wa';

interface Props {
  titleHtml: string;
  sub: string;
  catalogLabel: string;
  rebookLabel: string;
  websiteLabel: string;
  instagramLabel: string;
  ratingLabel: string;
  occupancyLabel: string;
  rebookMessage: string;
}

const {
  titleHtml,
  sub,
  catalogLabel,
  rebookLabel,
  websiteLabel,
  instagramLabel,
  ratingLabel,
  occupancyLabel,
  rebookMessage,
} = Astro.props;

const bookUrl =
  'https://lasaladitarentals.com?utm_source=guide&utm_medium=referral&utm_campaign=rebook';
const instagramUrl = 'https://instagram.com/saladitarentals';
const rebookUrl = buildWhatsAppUrl(rebookMessage);
---

<section class="stay-rebook section section--dark reveal" aria-labelledby="stay-rebook-title">
  <div class="container stay-rebook__inner">
    <div class="stay-rebook__copy reveal">
      <h2 id="stay-rebook-title" set:html={titleHtml} />
      <p class="stay-rebook__sub">{sub}</p>
    </div>

    <div class="stay-rebook__stats reveal" data-stats style="--i: 1">
      <div class="stay-rebook__stat">
        <span class="stay-rebook__stat-value">
          <span data-count data-target="4.9" data-decimals="1">0</span>★
        </span>
        <span class="stay-rebook__stat-label">{ratingLabel}</span>
      </div>
      <span class="stay-rebook__divider" aria-hidden="true">·</span>
      <div class="stay-rebook__stat">
        <span class="stay-rebook__stat-value">
          <span data-count data-from="80" data-target="90">80</span>–<span data-count-static>90</span>%
        </span>
        <span class="stay-rebook__stat-label">{occupancyLabel}</span>
      </div>
    </div>

    <div class="stay-rebook__actions reveal" style="--i: 2">
      <a
        class="stay-rebook__cta stay-rebook__cta--primary"
        href={WA_CATALOG_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="rebook-catalog"
        data-cta-type="link"
      >
        {catalogLabel}
      </a>
      <a
        class="stay-rebook__cta stay-rebook__cta--sand"
        href={rebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="rebook-whatsapp"
        data-cta-type="whatsapp"
      >
        {rebookLabel}
      </a>
      <a
        class="stay-rebook__cta stay-rebook__cta--secondary"
        href={bookUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="rebook-website"
        data-cta-type="link"
      >
        {websiteLabel}
      </a>
      <a
        class="stay-rebook__cta stay-rebook__cta--secondary"
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="instagram-rebook"
        data-cta-type="link"
      >
        {instagramLabel}
      </a>
    </div>
  </div>
</section>

<script>
  function initStayStats() {
    const stats = document.querySelector('[data-stats]');
    if (!stats || stats.dataset.ready === 'true') return;

    function animateValue(el, from, to, decimals = 0, duration = 1200) {
      const start = performance.now();

      function frame(now) {
        const progress = Math.min((now - start) / duration, 1);
        const value = from + (to - from) * progress;
        el.textContent = value.toFixed(decimals);
        if (progress < 1) requestAnimationFrame(frame);
      }

      requestAnimationFrame(frame);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;

        stats.querySelectorAll('[data-count]').forEach((el) => {
          const target = Number(el.dataset.target ?? 0);
          const from = Number(el.dataset.from ?? 0);
          const decimals = Number(el.dataset.decimals ?? 0);
          animateValue(el, from, target, decimals);
        });

        stats.dataset.ready = 'true';
        observer.disconnect();
      },
      { threshold: 0.35 },
    );

    observer.observe(stats);
  }

  initStayStats();
  document.addEventListener('astro:page-load', initStayStats);
</script>

<style>
  .stay-rebook {
    background: var(--navy);
    color: var(--cream);
    padding-block: 4.5rem;
  }

  .stay-rebook__inner {
    display: grid;
    gap: 2rem;
  }

  .stay-rebook__sub {
    margin-top: 0.75rem;
    max-width: 34rem;
    color: rgba(240, 237, 230, 0.9);
  }

  .stay-rebook__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1rem;
    font-family: var(--font-display);
  }

  .stay-rebook__stat-value {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-weight: 600;
  }

  .stay-rebook__stat-label {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--sage);
  }

  .stay-rebook__divider {
    color: var(--sage);
    font-size: 1.5rem;
  }

  .stay-rebook__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .stay-rebook__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.35rem;
    border-radius: var(--radius-chip);
    font-weight: 600;
    font-size: var(--text-small);
    transition: transform var(--dur) var(--ease-out);
  }

  .stay-rebook__cta:hover {
    transform: translateY(-2px);
  }

  .stay-rebook__cta--primary {
    background: var(--sand);
    color: var(--navy);
  }

  .stay-rebook__cta--sand {
    background: var(--sage);
    color: var(--navy);
  }

  .stay-rebook__cta--secondary {
    border: 1px solid var(--sage);
    color: var(--cream);
  }
</style>
