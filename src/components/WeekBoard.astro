---
interface Props {
  lang: 'en' | 'es';
  title: string;
  note: string;
  source: string;
  unavailable: string;
}

const { lang, title, note, source, unavailable } = Astro.props;
---

<section class="week-board section section--dark" id="section-surf" aria-labelledby="week-board-title" data-week-board data-lang={lang}>
  <div class="container">
    <p class="week-board__kicker">{title}</p>
    <p class="week-board__range" data-week-range>—</p>
    <h2 id="week-board-title" class="week-board__answer" data-week-answer>{unavailable}</h2>

    <div class="week-board__stats" data-week-stats hidden>
      <div class="week-board__stat">
        <span data-stat-h>—</span>
        <small>{lang === 'es' ? 'Altura' : 'Height'}</small>
      </div>
      <div class="week-board__stat">
        <span data-stat-p>—</span>
        <small>{lang === 'es' ? 'Período' : 'Period'}</small>
      </div>
      <div class="week-board__stat">
        <span data-stat-w>—</span>
        <small>{lang === 'es' ? 'Viento' : 'Wind'}</small>
      </div>
    </div>

    <div class="week-board__days" data-week-days role="list"></div>
    <p class="week-board__reason" data-week-reason></p>
    <p class="week-board__note">{note}</p>
    <p class="week-board__source">{source}</p>
  </div>
</section>

<script>
  const LAT = 17.841;
  const LNG = -101.771;

  function angularDistance(a, b) {
    const diff = Math.abs(a - b) % 360;
    return Math.min(diff, 360 - diff);
  }

  function windKind(deg) {
    const fromOffshore = angularDistance(deg, 40);
    if (fromOffshore <= 45) return 'offshore';
    if (fromOffshore <= 90) return 'cross';
    return 'onshore';
  }

  function compass(deg) {
    const names = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
    return names[Math.round(deg / 45) % 8];
  }

  function scoreDay(height, period, windDeg, windSpeed) {
    const heightScore = Math.max(0, 1 - Math.abs(height - 1.3) / 1.6) * 45;
    const periodScore = Math.min(Math.max((period - 8) / 8, 0), 1) * 30;
    const kind = windKind(windDeg);
    const windScore = kind === 'offshore' ? 25 : kind === 'cross' ? 10 : 0;
    const lightBonus = windSpeed < 18 ? 8 : windSpeed < 28 ? 3 : 0;
    return heightScore + periodScore + windScore + lightBonus;
  }

  function windWord(kind, lang) {
    const map = {
      en: { offshore: 'offshore', cross: 'cross', onshore: 'onshore' },
      es: { offshore: 'offshore', cross: 'cruzado', onshore: 'onshore' },
    };
    return map[lang][kind];
  }

  function fillFor(height, maxHeight) {
    return Math.max(28, Math.min(92, Math.round((height / Math.max(maxHeight, 0.6)) * 88)));
  }

  async function loadWeek() {
    const root = document.querySelector('[data-week-board]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const lang = root.dataset.lang === 'es' ? 'es' : 'en';
    const locale = lang === 'es' ? 'es-MX' : 'en-US';
    const rangeEl = root.querySelector('[data-week-range]');
    const answerEl = root.querySelector('[data-week-answer]');
    const reasonEl = root.querySelector('[data-week-reason]');
    const daysEl = root.querySelector('[data-week-days]');
    const statsEl = root.querySelector('[data-week-stats]');
    const statH = root.querySelector('[data-stat-h]');
    const statP = root.querySelector('[data-stat-p]');
    const statW = root.querySelector('[data-stat-w]');
    if (!rangeEl || !answerEl || !reasonEl || !daysEl || !statsEl || !statH || !statP || !statW) return;

    const marineUrl = `https://marine-api.open-meteo.com/v1/marine?latitude=${LAT}&longitude=${LNG}&daily=wave_height_max,wave_period_max,wave_direction_dominant&timezone=America%2FMexico_City&forecast_days=8`;
    const windUrl = `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LNG}&daily=wind_speed_10m_max,wind_direction_10m_dominant&timezone=America%2FMexico_City&forecast_days=8`;

    try {
      const [marineRes, windRes] = await Promise.all([fetch(marineUrl), fetch(windUrl)]);
      if (!marineRes.ok || !windRes.ok) throw new Error('forecast');
      const marine = await marineRes.json();
      const wind = await windRes.json();

      const days = marine.daily.time.map((date, i) => {
        const height = marine.daily.wave_height_max[i];
        const period = marine.daily.wave_period_max[i];
        const windDeg = wind.daily.wind_direction_10m_dominant[i];
        const windSpeed = wind.daily.wind_speed_10m_max[i];
        return {
          date,
          height,
          period,
          windDeg,
          windSpeed,
          kind: windKind(windDeg),
          score: scoreDay(height, period, windDeg, windSpeed),
        };
      });

      const best = days.reduce((top, day) => (day.score > top.score ? day : top), days[0]);
      const maxHeight = Math.max(...days.map((day) => day.height), 0.6);
      const first = new Date(`${days[0].date}T12:00:00`);
      const last = new Date(`${days[days.length - 1].date}T12:00:00`);
      const shortFmt = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric' });
      const weekdayFmt = new Intl.DateTimeFormat(locale, { weekday: 'short' });
      const longFmt = new Intl.DateTimeFormat(locale, { weekday: 'long', month: 'long', day: 'numeric' });
      const bestLabel = lang === 'es' ? 'Mejor' : 'Best';

      rangeEl.textContent = `${shortFmt.format(first)} – ${shortFmt.format(last)}`;

      function showDay(day, markAnswer) {
        const date = new Date(`${day.date}T12:00:00`);
        if (markAnswer) {
          answerEl.textContent =
            lang === 'es'
              ? `El mejor día es el ${longFmt.format(date)}.`
              : `The best day is ${longFmt.format(date)}.`;
        }
        statsEl.hidden = false;
        statH.textContent = `${day.height.toFixed(1)} m`;
        statP.textContent = `${Math.round(day.period)} s`;
        statW.textContent = `${compass(day.windDeg)} ${windWord(day.kind, lang)}`;
        reasonEl.hidden = true;
      }

      daysEl.innerHTML = '';
      days.forEach((day) => {
        const date = new Date(`${day.date}T12:00:00`);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `day-card day-card--${day.kind}`;
        button.setAttribute('role', 'listitem');
        if (day.date === best.date) button.classList.add('is-best', 'is-selected');
        const fill = fillFor(day.height, maxHeight);
        button.innerHTML = `
          <span class="day-card__tag">${day.date === best.date ? bestLabel : ''}</span>
          <span class="day-card__dow">${weekdayFmt.format(date)}</span>
          <span class="day-card__sea" aria-hidden="true">
            <i style="height:${fill}%"></i>
            <strong class="day-card__height">${day.height.toFixed(1)}<span>m</span></strong>
          </span>
          <span class="day-card__wind">${compass(day.windDeg)} · ${Math.round(day.period)}s</span>
        `;
        button.addEventListener('click', () => {
          daysEl.querySelectorAll('.day-card').forEach((el) => el.classList.remove('is-selected'));
          button.classList.add('is-selected');
          showDay(day, false);
          answerEl.textContent = longFmt.format(date);
        });
        daysEl.append(button);
      });

      showDay(best, true);
    } catch {
      root.dataset.ready = 'false';
    }
  }

  loadWeek();
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector('[data-week-board]');
    if (root) root.dataset.ready = 'false';
    loadWeek();
  });
</script>

<style>
  .week-board {
    scroll-margin-top: 4.25rem;
    background:
      radial-gradient(120% 80% at 50% 120%, rgba(164, 178, 176, 0.22), transparent 55%),
      var(--navy);
    color: var(--cream);
    padding-block: 2rem 2.4rem;
  }

  .week-board__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.35rem;
  }

  .week-board__range {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--sand);
    margin-bottom: 0.35rem;
  }

  .week-board__answer {
    font-size: clamp(1.7rem, 6.5vw, 2.6rem);
    max-width: 16ch;
    line-height: 1.05;
    margin-bottom: 1.1rem;
  }

  .week-board__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    margin-bottom: 1.15rem;
  }

  .week-board__stat {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 0.55rem;
    border-radius: 16px;
    background: rgba(224, 225, 220, 0.08);
    border: 1px solid rgba(231, 216, 192, 0.18);
  }

  .week-board__stat span {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 4vw, 1.55rem);
    line-height: 1;
    color: var(--sand);
  }

  .week-board__stat small {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .week-board__days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5.4rem;
    gap: 0.55rem;
    overflow-x: auto;
    padding-bottom: 0.4rem;
    margin-bottom: 0.9rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .week-board__days::-webkit-scrollbar {
    display: none;
  }

  .day-card {
    scroll-snap-align: start;
    display: grid;
    gap: 0.35rem;
    min-height: 11.5rem;
    padding: 0.5rem 0.4rem 0.55rem;
    border-radius: 18px;
    border: 1px solid rgba(164, 178, 176, 0.28);
    background: rgba(15, 39, 54, 0.45);
    color: var(--cream);
    text-align: left;
  }

  .day-card__tag {
    min-height: 0.85rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand);
  }

  .day-card__dow {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .day-card__sea {
    position: relative;
    height: 92px;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(224, 225, 220, 0.1);
  }

  .day-card__sea i {
    position: absolute;
    left: -12%;
    right: -12%;
    bottom: 0;
    border-radius: 42% 58% 0 0;
    background: #c5d4cf;
    box-shadow: inset 0 8px 0 rgba(231, 216, 192, 0.85);
  }

  .day-card--offshore .day-card__sea i {
    background: #e7d8c0;
    box-shadow: inset 0 10px 0 #f3eadb;
  }

  .day-card--onshore .day-card__sea i {
    background: #3c5b6f;
    box-shadow: inset 0 8px 0 #6d8589;
  }

  .day-card__height {
    position: absolute;
    left: 0.35rem;
    bottom: 0.3rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1;
    color: var(--navy);
  }

  .day-card--onshore .day-card__height {
    color: var(--cream);
  }

  .day-card__height span {
    margin-left: 0.12rem;
    font-size: 0.7rem;
    font-family: var(--font-body);
    color: var(--sage);
  }

  .day-card__wind {
    font-size: 0.72rem;
    color: var(--sage);
  }

  .day-card.is-best {
    border-color: var(--sand);
    background: rgba(231, 216, 192, 0.14);
  }

  .day-card.is-selected {
    outline: 2px solid var(--sand);
    outline-offset: 2px;
  }

  .week-board__reason,
  .week-board__note,
  .week-board__source {
    font-size: 0.8rem;
    color: var(--sage);
    max-width: 40rem;
  }

  .week-board__note {
    margin-top: 0.35rem;
  }

  .week-board__source {
    margin-top: 0.25rem;
  }

  @media (min-width: 800px) {
    .week-board__days {
      grid-auto-flow: unset;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-columns: unset;
      overflow: visible;
    }
  }
</style>
