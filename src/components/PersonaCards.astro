---
interface Persona {
  id: string;
  emoji: string;
  title: string;
  desc: string;
  cta: string;
  target: string;
}

interface Props {
  title: string;
  personas: Persona[];
}

const { title, personas } = Astro.props;
---

<section class="personas section" aria-labelledby="personas-title">
  <div class="container">
    <h2 id="personas-title" class="personas__title reveal">{title}</h2>
    <div class="personas__grid">
      {
        personas.map((persona, index) => (
          <article class="persona-card reveal" style={`--i: ${index}`}>
            <span class="persona-card__emoji" aria-hidden="true">
              {persona.emoji}
            </span>
            <h3 class="persona-card__name">{persona.title}</h3>
            <p class="persona-card__desc">{persona.desc}</p>
            <a class="persona-card__cta" href={persona.target} data-persona-jump={persona.id}>
              {persona.cta}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function initPersonaJump() {
    document.querySelectorAll<HTMLAnchorElement>('[data-persona-jump]').forEach((link) => {
      if (link.dataset.bound === 'true') return;
      link.dataset.bound = 'true';

      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href?.startsWith('#')) return;

        const target = document.querySelector(href);
        if (!target) return;

        event.preventDefault();
        const navHeight = document.querySelector('.guide-nav')?.getBoundingClientRect().height ?? 0;
        const top = target.getBoundingClientRect().top + window.scrollY - navHeight - 12;
        window.scrollTo({ top, behavior: 'smooth' });
        history.replaceState(null, '', href);
      });
    });
  }

  initPersonaJump();
  document.addEventListener('astro:page-load', initPersonaJump);
</script>

<style>
  .personas {
    padding-block: 2.5rem 2rem;
    background: var(--cream);
  }

  .personas__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--navy);
  }

  .personas__grid {
    display: grid;
    gap: 1rem;
  }

  .persona-card {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--sand);
    border: 1px solid rgba(148, 137, 121, 0.2);
    box-shadow: var(--shadow-card);
  }

  .persona-card__emoji {
    font-size: 1.75rem;
    line-height: 1;
  }

  .persona-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--navy);
  }

  .persona-card__desc {
    font-size: var(--text-small);
    color: var(--taupe);
    max-width: 40ch;
  }

  .persona-card__cta {
    justify-self: start;
    margin-top: 0.35rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-chip);
    background: var(--navy);
    color: var(--cream);
    font-size: var(--text-small);
    font-weight: 600;
    transition: transform var(--dur) var(--ease-out);
  }

  .persona-card__cta:active {
    transform: scale(0.98);
  }

  @media (min-width: 768px) {
    .personas__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
