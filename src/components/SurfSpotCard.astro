---
import type { Lang } from '../utils/i18n';
import type { SurfSpot } from '../types/surf-spot';
import { buildMapsDirectionsUrl } from '../utils/wa';
import Sketch from './Sketch.astro';

interface Props {
  spot: SurfSpot;
  lang: Lang;
  mapsLabel: string;
  revealIndex?: number;
  labels: {
    type: string;
    board: string;
    level: string;
    tide: string;
    wind: string;
    swell: string;
    access: string;
    ride: string;
  };
}

const { spot, lang, mapsLabel, revealIndex = 0, labels } = Astro.props;
const image = spot.image ?? `/media/places/${spot.id}.jpg`;
const mapsUrl = spot.mapsQuery
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(spot.mapsQuery)}`
  : buildMapsDirectionsUrl(spot.lat, spot.lng);
---

<article class="surf-spot-card reveal" style={`--i: ${revealIndex}`}>
  <div class="surf-spot-card__media">
    <span class="surf-spot-card__draw"><Sketch name="board" /></span>
    <img class="surf-spot-card__image" src={image} alt="" loading="lazy" decoding="async" data-spot-image />
  </div>

  <div class="surf-spot-card__body">
    <span class="surf-spot-card__badge">{spot.badge[lang]}</span>
    <h3 class="surf-spot-card__name">{spot.name[lang]}</h3>
    <p class="surf-spot-card__summary">{spot.summary[lang]}</p>

    <dl class="surf-spot-card__specs">
      <div><dt>{labels.board}</dt><dd>{spot.board[lang]}</dd></div>
      <div><dt>{labels.level}</dt><dd>{spot.level[lang]}</dd></div>
      <div><dt>{labels.wind}</dt><dd>{spot.wind[lang]}</dd></div>
      <div><dt>{labels.tide}</dt><dd>{spot.tide[lang]}</dd></div>
      <div><dt>{labels.access}</dt><dd>{spot.access[lang]}</dd></div>
      {
        spot.rideLength && (
          <div class="surf-spot-card__ride">
            <dt>{labels.ride}</dt>
            <dd>{spot.rideLength[lang]}</dd>
          </div>
        )
      }
    </dl>

    <a class="surf-spot-card__cta" href={mapsUrl} target="_blank" rel="noopener noreferrer">
      {mapsLabel}
    </a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLImageElement>('[data-spot-image]').forEach((img) => {
    img.addEventListener('error', () => img.remove());
  });
</script>

<style>
  .surf-spot-card {
    background: #f7f4ee;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }

  .surf-spot-card:active {
    transform: scale(0.985);
  }

  .surf-spot-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(160deg, #153448, #3c5b6f);
    color: var(--sand);
  }

  .surf-spot-card__draw {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .surf-spot-card__draw :global(.sketch) {
    width: 6.5rem;
  }

  .surf-spot-card__image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .surf-spot-card__body {
    display: grid;
    gap: 0.75rem;
    padding: 1.15rem;
  }

  .surf-spot-card__badge {
    justify-self: start;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-chip);
    background: var(--sage);
    color: var(--navy);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .surf-spot-card__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .surf-spot-card__summary {
    font-size: var(--text-small);
    color: var(--taupe);
  }

  .surf-spot-card__specs {
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-small);
  }

  .surf-spot-card__specs div {
    display: grid;
    gap: 0.15rem;
  }

  .surf-spot-card__specs dt {
    color: var(--taupe);
    font-weight: 600;
  }

  .surf-spot-card__ride dd {
    font-weight: 700;
    color: var(--navy);
  }

  .surf-spot-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-chip);
    background: var(--navy);
    color: var(--cream);
    font-weight: 600;
    font-size: var(--text-small);
  }
</style>
