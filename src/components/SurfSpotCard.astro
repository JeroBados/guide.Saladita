---
import type { Lang } from '../utils/i18n';
import type { SurfSpot } from '../types/surf-spot';
import { buildMapsDirectionsUrl } from '../utils/wa';
import Sketch from './Sketch.astro';

interface Props {
  spot: SurfSpot;
  lang: Lang;
  index: number;
  mapsLabel: string;
  labels: Record<'board' | 'level' | 'tide' | 'wind' | 'swell' | 'access' | 'ride', string>;
}

const { spot, lang, index, mapsLabel, labels } = Astro.props;
const showMap = spot.showMap !== false;
const mapsUrl = showMap
  ? spot.mapsQuery
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(spot.mapsQuery)}`
    : buildMapsDirectionsUrl(spot.lat, spot.lng)
  : null;
const isShort = spot.board.en.toLowerCase().startsWith('short');
const tilt = [-0.6, 0.5, -0.3][index % 3];
---

<article class="spot" id={spot.id} style={`--tilt: ${tilt}deg; --delay: ${index * 80}ms`}>
  <header class="spot__head">
    <span class="spot__num data" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <div>
      <h3 class="spot__name">{spot.name[lang]}</h3>
      <p class="spot__badge hand">{spot.badge[lang]}</p>
    </div>
    <Sketch name={isShort ? 'shortboard' : 'longboard'} class="spot__board" />
  </header>

  <p class="spot__summary">{spot.summary[lang]}</p>

  <dl class="spot__specs">
    <div><dt class="eyebrow"><Sketch name="wind" />{labels.wind}</dt><dd>{spot.wind[lang]}</dd></div>
    <div><dt class="eyebrow"><Sketch name="tide" />{labels.tide}</dt><dd>{spot.tide[lang]}</dd></div>
    <div><dt class="eyebrow"><Sketch name="wave" />{labels.swell}</dt><dd>{spot.swell[lang]}</dd></div>
    <div><dt class="eyebrow"><Sketch name="pin" />{labels.access}</dt><dd>{spot.access[lang]}</dd></div>
    {
      spot.rideLength && (
        <div>
          <dt class="eyebrow"><Sketch name="arrow" />{labels.ride}</dt>
          <dd><span class="hl">{spot.rideLength[lang]}</span></dd>
        </div>
      )
    }
  </dl>

  {
    mapsUrl && (
      <a class="pen-link spot__maps" href={mapsUrl} target="_blank" rel="noopener noreferrer" data-track-cta data-place-id={spot.id} data-cta-type="maps">
        {mapsLabel} →
      </a>
    )
  }
</article>

<style>
  .spot {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1.35rem 1.2rem 1rem;
    background: var(--paper-3);
    border: 1.5px solid var(--sr-card-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-paper);
    transform: rotate(var(--tilt, 0deg));
    animation: spotIn 500ms var(--ease-out) both;
    animation-delay: var(--delay, 0ms);
  }

  @keyframes spotIn {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(var(--tilt, 0deg));
    }

    to {
      opacity: 1;
      transform: translateY(0) rotate(var(--tilt, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot {
      animation: none;
    }
  }

  /* left margin line, like a notebook page */
  .spot::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2.9rem;
    width: 1.5px;
    background: rgba(154, 74, 43, 0.28);
  }

  .spot__head {
    display: grid;
    grid-template-columns: 2.2rem 1fr auto;
    gap: 0.9rem;
    align-items: start;
  }

  .spot__num {
    font-size: 1.6rem;
    color: var(--accent);
  }

  .spot__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.65rem;
  }

  .spot__badge {
    font-size: 1.3rem;
    margin-top: 0.1rem;
    transform: rotate(-1.5deg);
    transform-origin: left;
  }

  .spot__head :global(.spot__board) {
    width: 4.6rem;
    color: var(--ink-2);
    transform: rotate(-18deg);
    margin-top: 0.3rem;
  }

  .spot__summary,
  .spot__specs,
  .spot__maps {
    margin-left: 3.1rem;
  }

  .spot__specs {
    display: grid;
    gap: 0.65rem;
  }

  .spot__specs div {
    display: grid;
    gap: 0.05rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed rgba(43, 34, 29, 0.18);
  }

  .spot__specs dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .spot__specs dt :global(.sketch) {
    width: 1.5rem;
    flex: none;
  }

  .spot__specs dd {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .spot__maps {
    justify-self: start;
    font-size: 0.95rem;
  }
</style>
