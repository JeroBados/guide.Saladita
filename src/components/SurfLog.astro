---
/* "This week's log": the best morning to surf the Saladita point in the next 8 days,
   plus a static month-by-month season strip (the part search engines and AIs quote). */
import Sketch from './Sketch.astro';
import type { Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const locale = lang === 'es' ? 'es-MX' : 'en-US';
const monthFmt = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
// 1 = small, 2 = medium, 3 = best (from local experience, not a model)
const waves = [1, 1, 1, 2, 3, 3, 3, 3, 3, 2, 1, 1];
const crowd = [3, 3, 3, 2, 1, 1, 1, 1, 1, 1, 3, 3];
const months = waves.map((w, i) => ({
  name: monthFmt.format(new Date(Date.UTC(2026, i, 15))).replace('.', ''),
  waves: w,
  crowd: crowd[i],
}));

const i18n = {
  best: t['week.best'],
  window: t['week.window'],
  answer: t['week.answer'],
  swell: t['week.swell'],
  wind: t['week.wind'],
  tide: t['week.tide'],
  offshore: t['week.offshore'],
  cross: t['week.cross'],
  onshore: t['week.onshore'],
  glassy: t['week.glassy'],
  low: t['week.tideLow'],
  mid: t['week.tideMid'],
  high: t['week.tideHigh'],
  rising: t['week.rising'],
  falling: t['week.falling'],
  ratings: [t['week.r1'], t['week.r2'], t['week.r3'], t['week.r4']],
  gone: t['week.gone'],
  source: t['week.source'],
};
---

<section class="section log" id="section-surf" aria-labelledby="log-title">
  <div class="container">
    <div class="section__header">
      <p class="section__kicker hand"><Sketch name="wave" />{t['week.kicker']}</p>
      <h2 id="log-title" set:html={t['week.title']} />
      <p class="section__lead">{t['week.lead']}</p>
    </div>

    <div class="log__page" data-surf-log data-lang={lang} data-locale={locale} data-i18n={JSON.stringify(i18n)}>
      <span class="tape log__tape" aria-hidden="true"></span>
      <p class="log__range hand" data-range></p>
      <p class="log__answer" data-answer aria-live="polite">{t['week.unavailable']}</p>

      <div class="log__days-wrap">
        <div class="log__days" data-days role="list" aria-label={t['week.daysLabel']}></div>
      </div>

      <div class="log__detail" data-detail hidden>
        <p class="log__detail-title" data-detail-title></p>
        <dl>
          <div><dt><Sketch name="wave" />{t['week.swell']}</dt><dd data-d-swell></dd></div>
          <div><dt><Sketch name="wind" />{t['week.wind']}</dt><dd data-d-wind></dd></div>
          <div><dt><Sketch name="tide" />{t['week.tide']}</dt><dd data-d-tide></dd></div>
        </dl>
      </div>

      <p class="log__note hand">{t['week.note']}</p>
      <p class="log__source">{t['week.source']}</p>
    </div>

    <div class="season">
      <h3 class="season__title">{t['season.title']}</h3>
      <p class="season__summary">{t['season.summary']}</p>
      <div class="season__grid" role="table" aria-label={t['season.title']}>
        <div class="season__row season__row--head" role="row">
          <span role="columnheader"><span class="sr-only">{t['season.month']}</span></span>
          {months.map((m) => <span role="columnheader">{m.name}</span>)}
        </div>
        <div class="season__row" role="row">
          <span role="rowheader" class="season__label hand">{t['season.waves']}</span>
          {
            months.map((m) => (
              <span role="cell" class={`season__wave season__wave--${m.waves}`}>
                <span class="sr-only">{m.name}: {t[`season.level${m.waves}`]}</span>
                <svg viewBox="0 0 24 30" aria-hidden="true">
                  <path d={m.waves === 3 ? 'M2 28C4 10 12 2 22 4c-6 4-8 10-6 16' : m.waves === 2 ? 'M2 28c3-10 9-15 18-14-4 3-5 7-4 10' : 'M2 28c3-5 8-8 16-7-3 2-4 4-3 6'} />
                </svg>
              </span>
            ))
          }
        </div>
        <div class="season__row" role="row">
          <span role="rowheader" class="season__label hand">{t['season.crowd']}</span>
          {
            months.map((m) => (
              <span role="cell" class="season__crowd">
                <span class="sr-only">{m.name}: {t[`season.crowd${m.crowd}`]}</span>
                {Array.from({ length: m.crowd }).map(() => <i aria-hidden="true" />)}
              </span>
            ))
          }
        </div>
      </div>
      <p class="season__foot hand">{t['season.foot']}</p>
    </div>
  </div>
</section>

<script>
  type Day = {
    date: string;
    score: number | null;
    start: number;
    swell: number;
    period: number;
    swellDir: number;
    windSpeed: number;
    windDir: number;
    windKind: 'offshore' | 'cross' | 'onshore' | 'glassy';
    tideLevel: number;
    tideRising: boolean;
  };

  const LAT = 17.841;
  const LNG = -101.771;
  const TZ = 'America/Mexico_City';

  const ang = (a: number, b: number) => {
    const d = Math.abs(a - b) % 360;
    return Math.min(d, 360 - d);
  };
  const clamp = (v: number, lo = 0, hi = 1) => Math.max(lo, Math.min(hi, v));
  const compass = (deg: number) => ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.round(deg / 45) % 8];

  function windKind(dir: number, speed: number): Day['windKind'] {
    if (speed < 7) return 'glassy';
    const d = ang(dir, 30); // the point is offshore with N–NE wind
    if (d <= 60) return 'offshore';
    if (d <= 110) return 'cross';
    return 'onshore';
  }

  function hourScore(swell: number, period: number, swellDir: number, windDir: number, windSpeed: number, tide: number) {
    const size = swell < 0.3 ? 0 : swell < 1 ? (swell - 0.3) / 0.7 : swell <= 2 ? 1 : swell < 3.2 ? 1 - ((swell - 2) / 1.2) * 0.5 : 0.4;
    const per = clamp((period - 6) / 8, 0.15, 1);
    const dd = ang(swellDir, 210); // the long left wants S–SW swell
    const dir = dd <= 35 ? 1 : dd <= 75 ? 1 - ((dd - 35) / 40) * 0.6 : 0.2;
    const kind = windKind(windDir, windSpeed);
    const wind =
      kind === 'glassy' ? 0.95 : kind === 'offshore' ? (windSpeed < 25 ? 1 : 0.7) : kind === 'cross' ? (windSpeed < 15 ? 0.5 : 0.25) : windSpeed < 12 ? 0.35 : 0.1;
    const tideS = tide <= 0.62 ? 1 : tide <= 0.82 ? 0.7 : 0.45; // mid to low
    return 100 * (0.32 * size + 0.18 * per + 0.14 * dir + 0.26 * wind + 0.1 * tideS);
  }

  function nowParts() {
    const f = new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', hour12: false });
    const p = Object.fromEntries(f.formatToParts(new Date()).map((x) => [x.type, x.value]));
    return { date: `${p.year}-${p.month}-${p.day}`, hour: Number(p.hour) % 24 };
  }

  function wavePath(height: number) {
    const amp = 4 + clamp(height / 3) * 22;
    const base = 44;
    return `M2 ${base} C 10 ${base - amp * 0.4}, 16 ${base - amp}, 26 ${base - amp} C 36 ${base - amp}, 40 ${base - amp * 0.35}, 34 ${base - amp * 0.2} C 42 ${base - amp * 0.1}, 50 ${base}, 58 ${base}`;
  }

  async function run() {
    const root = document.querySelector<HTMLElement>('[data-surf-log]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const lang = root.dataset.lang === 'es' ? 'es' : 'en';
    const locale = root.dataset.locale || 'en-US';
    const t = JSON.parse(root.dataset.i18n || '{}');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    const models = ['ecmwf_wam', 'ncep_gfswave025', 'meteofrance_wave'];
    const marineBase = `https://marine-api.open-meteo.com/v1/marine?latitude=${LAT}&longitude=${LNG}&hourly=wave_height,swell_wave_height,swell_wave_period,swell_wave_direction,sea_level_height_msl&timezone=${encodeURIComponent(TZ)}&forecast_days=8&models=`;
    const windUrl = `https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LNG}&hourly=wind_speed_10m,wind_direction_10m&timezone=${encodeURIComponent(TZ)}&forecast_days=8`;

    try {
      const fetched = await Promise.all([
        ...models.map(async (model) => {
          try {
            const res = await fetch(marineBase + model);
            if (!res.ok) return null;
            return ((await res.json()).hourly as Record<string, (number | null)[] | string[]> | undefined) ?? null;
          } catch {
            return null;
          }
        }),
        fetch(windUrl).then(async (res) => (res.ok ? ((await res.json()).hourly as Record<string, (number | null)[] | string[]>) : null)),
      ]);
      const windHours = fetched.pop() as Record<string, (number | null)[] | string[]> | null;
      const sources = fetched.filter((src): src is Record<string, (number | null)[] | string[]> => src != null && Array.isArray(src.time));
      if (!sources.length || !windHours) throw new Error('forecast');
      const m = sources[0];
      const w = windHours;
      const now = nowParts();

      const byDate = new Map<string, number[]>();
      (m.time as string[]).forEach((iso, i) => {
        const d = iso.slice(0, 10);
        if (!byDate.has(d)) byDate.set(d, []);
        byDate.get(d)!.push(i);
      });

      const days: Day[] = [];
      byDate.forEach((idxs, date) => {
        const levels = idxs.map((i) => m.sea_level_height_msl[i]).filter((v: number | null) => v != null);
        const lo = Math.min(...levels);
        const hi = Math.max(...levels);
        const norm = (v: number) => (hi - lo > 0.05 ? (v - lo) / (hi - lo) : 0.5);
        const hourIdx = (h: number) => idxs.find((i) => Number(m.time[i].slice(11, 13)) === h);
        let best: Day | null = null;
        for (let start = 5; start <= 8; start++) {
          if (date === now.date && start < now.hour) continue;
          const hs = [start, start + 1, start + 2].map(hourIdx).filter((i): i is number => i != null);
          if (hs.length < 3) continue;
          const val = (arr: (number | null)[], i: number, alt?: (number | null)[]) => (arr[i] ?? alt?.[i] ?? 0) as number;
          const num = (src: Record<string, (number | null)[] | string[]>, key: string, i: number, alt?: string) => {
            const primary = src[key];
            const fallback = alt ? src[alt] : undefined;
            const value = (Array.isArray(primary) ? primary[i] : null) ?? (Array.isArray(fallback) ? fallback[i] : null);
            return typeof value === 'number' ? value : null;
          };
          const blend = (i: number) => {
            const rows = sources
              .map((src) => {
                const swell = num(src, 'swell_wave_height', i, 'wave_height');
                const period = num(src, 'swell_wave_period', i);
                const dir = num(src, 'swell_wave_direction', i);
                if (swell == null || period == null || dir == null) return null;
                return {
                  swell,
                  period,
                  dir,
                  score: hourScore(swell, period, dir, val(w.wind_direction_10m, i), val(w.wind_speed_10m, i), norm(val(m.sea_level_height_msl, i))),
                };
              })
              .filter((row): row is { swell: number; period: number; dir: number; score: number } => row != null);
            if (!rows.length) return null;
            const sin = rows.reduce((sum, row) => sum + Math.sin((row.dir * Math.PI) / 180), 0);
            const cos = rows.reduce((sum, row) => sum + Math.cos((row.dir * Math.PI) / 180), 0);
            return {
              score: rows.reduce((sum, row) => sum + row.score, 0) / rows.length,
              swell: rows.reduce((sum, row) => sum + row.swell, 0) / rows.length,
              period: rows.reduce((sum, row) => sum + row.period, 0) / rows.length,
              dir: (Math.atan2(sin, cos) * 180) / Math.PI,
            };
          };
          const blends = hs.map(blend).filter((row): row is NonNullable<ReturnType<typeof blend>> => row != null);
          if (blends.length < 3) continue;
          const score = blends.reduce((sum, row) => sum + row.score, 0) / blends.length;
          if (!best || score > (best.score ?? -1)) {
            const i = hs[1];
            const mid = blends[1] ?? blends[0];
            const ws = val(w.wind_speed_10m, i);
            const wd = val(w.wind_direction_10m, i);
            best = {
              date,
              score,
              start,
              swell: mid.swell,
              period: mid.period,
              swellDir: (mid.dir + 360) % 360,
              windSpeed: ws,
              windDir: wd,
              windKind: windKind(wd, ws),
              tideLevel: norm(val(m.sea_level_height_msl, i)),
              tideRising: val(m.sea_level_height_msl, hs[2]) > val(m.sea_level_height_msl, hs[0]),
            };
          }
        }
        days.push(best ?? { date, score: null, start: 6, swell: 0, period: 0, swellDir: 0, windSpeed: 0, windDir: 0, windKind: 'glassy', tideLevel: 0.5, tideRising: true });
      });

      const scored = days.filter((d) => d.score != null);
      if (!scored.length) throw new Error('empty');
      const top = scored.reduce((a, b) => ((b.score ?? 0) > (a.score ?? 0) ? b : a));

      const sourceEl = root.querySelector('.log__source');
      if (sourceEl && t.source) sourceEl.textContent = String(t.source).replace('{n}', String(sources.length));

      const dFmt = (iso: string, o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(locale, { ...o, timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
      const windowLabel = (d: Day) => (d.start + 3 < 12 ? `${d.start}–${d.start + 3} am` : `${d.start} am–12 pm`);
      const ft = (mtr: number) => Math.round(mtr * 3.28);
      const rating = (s: number) => (s >= 85 ? 3 : s >= 72 ? 2 : s >= 58 ? 1 : 0);

      $('[data-range]').textContent = `${dFmt(days[0].date, { month: 'short', day: 'numeric' })} – ${dFmt(days[days.length - 1].date, { month: 'short', day: 'numeric' })}`;
      $('[data-answer]').innerHTML = t.answer
        .replace('{day}', `<span class="hl">${dFmt(top.date, { weekday: 'long', month: 'short', day: 'numeric' })}</span>`)
        .replace('{window}', windowLabel(top));

      const detail = $('[data-detail]');
      function show(d: Day) {
        detail.hidden = false;
        $('[data-detail-title]').textContent = `${dFmt(d.date, { weekday: 'long', month: 'short', day: 'numeric' })} · ${t.window} ${windowLabel(d)}`;
        $('[data-d-swell]').textContent = `${d.swell.toFixed(1)} m (${ft(d.swell)} ft) · ${Math.round(d.period)} s · ${compass(d.swellDir)}`;
        $('[data-d-wind]').textContent = `${Math.round(d.windSpeed)} km/h ${compass(d.windDir)} · ${t[d.windKind]}`;
        const lvl = d.tideLevel < 0.34 ? t.low : d.tideLevel < 0.67 ? t.mid : t.high;
        $('[data-d-tide]').textContent = `${lvl}, ${d.tideRising ? t.rising : t.falling}`;
      }

      const wrap = $('[data-days]');
      wrap.innerHTML = '';
      days.forEach((d) => {
        const isBest = d.date === top.date;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day${isBest ? ' day--best is-selected' : ''}${d.score == null ? ' day--gone' : ''}`;
        btn.setAttribute('role', 'listitem');
        btn.setAttribute('aria-pressed', String(isBest));
        const r = d.score == null ? -1 : rating(d.score);
        const dots = r < 0 ? '' : Array.from({ length: 4 }, (_, k) => `<i class="${k <= r ? 'on' : ''}"></i>`).join('');
        btn.innerHTML = `
          ${isBest ? `<svg class="day__circle" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true"><path d="M70 6C40-2 8 14 6 60s14 76 46 74 46-30 42-72S74 4 44 10"/></svg><span class="day__best hand">${t.best}</span>` : ''}
          <span class="day__dow">${dFmt(d.date, { weekday: 'short' })}</span>
          <span class="day__num">${dFmt(d.date, { day: 'numeric' })}</span>
          <svg class="day__wave" viewBox="0 0 60 48" aria-hidden="true"><path d="${d.score == null ? 'M2 44 H58' : wavePath(d.swell)}"/><path class="day__sea" d="M2 46 H58"/></svg>
          <span class="day__h">${d.score == null ? '—' : `${d.swell.toFixed(1)}<small>m</small>`}</span>
          <span class="day__wind" title="${compass(d.windDir)}">${d.score == null ? '' : `<svg viewBox="0 0 20 20" style="transform:rotate(${(d.windDir + 180) % 360}deg)" aria-hidden="true"><path d="M10 17V3M5 8l5-5 5 5"/></svg>${compass(d.windDir)}`}</span>
          <span class="day__dots" aria-hidden="true">${dots}</span>
          <span class="day__rate hand">${d.score == null ? t.gone : t.ratings[r]}</span>`;
        if (d.score != null) {
          btn.addEventListener('click', () => {
            wrap.querySelectorAll('.day').forEach((el) => {
              el.classList.remove('is-selected');
              el.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-pressed', 'true');
            show(d);
          });
        } else {
          btn.disabled = true;
        }
        wrap.append(btn);
      });
      show(top);
      root.classList.add('is-live');
      const bestEl = wrap.querySelector<HTMLElement>('.day--best');
      const scroller = root.querySelector<HTMLElement>('.log__days-wrap');
      if (bestEl && scroller && scroller.scrollWidth > scroller.clientWidth) {
        scroller.scrollLeft = Math.max(0, bestEl.offsetLeft - scroller.clientWidth / 2 + bestEl.offsetWidth / 2);
      }
    } catch {
      delete root.dataset.ready;
    }
  }

  run();
  document.addEventListener('astro:page-load', run);
</script>

<style is:global>
  .log__page {
    position: relative;
    padding: 1.4rem 1.1rem 1.25rem;
    background-color: var(--paper-3);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
    border: 1px solid rgba(21, 52, 72, 0.12);
    box-shadow: var(--shadow-lift);
    transform: rotate(-0.4deg);
  }

  .log__tape {
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .log__range {
    font-size: 1.5rem;
    color: var(--pencil);
    min-height: 1.6rem;
  }

  .log__answer {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    max-width: 22ch;
    margin: 0.3rem 0 1.4rem;
    text-wrap: balance;
  }

  .log:not(:has(.is-live)) .log__answer {
    font-size: 1.15rem;
    font-weight: 500;
    max-width: 44ch;
  }

  .log__days-wrap {
    position: relative;
    margin-inline: -1.1rem;
    padding-inline: 1.1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .log__days-wrap::-webkit-scrollbar {
    display: none;
  }

  .log__days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5.2rem;
    gap: 0.4rem;
    padding: 1.5rem 0.2rem 0.6rem;
  }

  .day {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.55rem 0.3rem 0.5rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-hand);
    background: transparent;
    color: var(--ink);
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .day:hover:not(:disabled) {
    background: rgba(231, 216, 192, 0.45);
  }

  .day.is-selected {
    background: rgba(241, 210, 122, 0.28);
    border-color: rgba(21, 52, 72, 0.35);
  }

  .day:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .day__circle {
    position: absolute;
    inset: -0.6rem -0.45rem -0.4rem;
    width: calc(100% + 0.9rem);
    height: calc(100% + 1rem);
    fill: none;
    stroke: #c0392b;
    stroke-width: 2.2;
    stroke-linecap: round;
    pointer-events: none;
    overflow: visible;
  }

  .day__best {
    position: absolute;
    top: -1.55rem;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg);
    font-size: 1.25rem;
    font-weight: 700;
    color: #b0342a;
    white-space: nowrap;
  }

  .day__dow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pencil);
  }

  .day__num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
  }

  .day__wave {
    width: 3.4rem;
    height: 2.8rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__sea {
    stroke: var(--taupe);
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .day__h {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .day__h small {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    margin-left: 0.1rem;
    color: var(--pencil);
  }

  .day__wind {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
    min-height: 1rem;
  }

  .day__wind svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__dots {
    display: flex;
    gap: 3px;
    min-height: 6px;
  }

  .day__dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.2px solid var(--ink-2);
  }

  .day__dots i.on {
    background: var(--ink);
    border-color: var(--ink);
  }

  .day__rate {
    font-size: 1.1rem;
    line-height: 1;
  }

  .log__detail {
    margin-top: 0.8rem;
