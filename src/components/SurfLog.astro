---
/* "This week's log": best morning at the Saladita point from Surfline + surf-forecast
   (averaged), with Open-Meteo tide fill. Season chart is interactive (SEO copy stays). */
import fs from 'node:fs';
import path from 'node:path';
import Sketch from './Sketch.astro';
import SeasonChart from './SeasonChart.astro';
import type { Lang } from '../utils/i18n';
import { prepareWeek, type WeekLogI18n, type WeekPayload } from '../utils/week-forecast';

interface Props {
  lang: Lang;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const locale = lang === 'es' ? 'es-MX' : 'en-US';

const i18n: WeekLogI18n = {
  best: t['week.best'],
  window: t['week.window'],
  answer: t['week.answer'],
  swell: t['week.swell'],
  wind: t['week.wind'],
  tide: t['week.tide'],
  offshore: t['week.offshore'],
  cross: t['week.cross'],
  onshore: t['week.onshore'],
  glassy: t['week.glassy'],
  low: t['week.tideLow'],
  mid: t['week.tideMid'],
  high: t['week.tideHigh'],
  rising: t['week.rising'],
  falling: t['week.falling'],
  ratings: [t['week.r1'], t['week.r2'], t['week.r3'], t['week.r4']],
  gone: t['week.gone'],
  source: t['week.source'],
};

function loadWeekForecastFile(): WeekPayload | null {
  try {
    const file = path.join(process.cwd(), 'public/data/week-forecast.json');
    return JSON.parse(fs.readFileSync(file, 'utf8')) as WeekPayload;
  } catch {
    return null;
  }
}

const prepared = prepareWeek(loadWeekForecastFile(), lang, locale, i18n);
const live = prepared != null;
const surflineUrl = 'https://www.surfline.com/surf-report/la-saladita/584204204e65fad6a770921e';
---

<section class="section log" id="section-surf" aria-labelledby="log-title">
  <div class="container">
    <div class="section__header">
      <p class="section__kicker hand"><Sketch name="wave" />{t['week.kicker']}</p>
      <h2 id="log-title" set:html={t['week.title']} />
      <p class="section__lead">{t['week.lead']}</p>
    </div>

    <div
      class:list={['log__page', live && 'is-live']}
      data-surf-log
      data-lang={lang}
      data-locale={locale}
      data-i18n={JSON.stringify(i18n)}
    >
      <span class="tape log__tape" aria-hidden="true"></span>
      <p class="log__range eyebrow" data-range>{prepared?.range ?? ''}</p>
      <p class="log__answer" data-answer aria-live="polite" set:html={prepared?.answerHtml ?? t['week.unavailable']} />
      {
        !live && (
          <p class="log__fallback" data-surfline-fallback>
            <a class="pen-link" href={surflineUrl} target="_blank" rel="noopener noreferrer">
              {t['week.surflineCta']} →
            </a>
          </p>
        )
      }

      <div class="log__days-wrap">
        <div class="log__days" data-days role="list" aria-label={t['week.daysLabel']}>
          {
            prepared?.days.map((d) => {
              const dots =
                d.rating < 0
                  ? null
                  : [0, 1, 2, 3].map((k) => <i class={k <= d.rating ? 'on' : undefined} />);
              return (
                <button
                  type="button"
                  class:list={['day', d.isBest && 'day--best is-selected', d.gone && 'day--gone']}
                  role="listitem"
                  aria-pressed={d.isBest ? 'true' : 'false'}
                  disabled={d.gone || undefined}
                  data-date={d.date}
                >
                  {d.isBest && (
                    <>
                      <svg class="day__circle" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true">
                        <path d="M70 6C40-2 8 14 6 60s14 76 46 74 46-30 42-72S74 4 44 10" />
                      </svg>
                      <span class="day__best hand">{t['week.best']}</span>
                    </>
                  )}
                  <span class="day__dow">{d.dow}</span>
                  <span class="day__num">{d.dayNum}</span>
                  <svg class="day__wave" viewBox="0 0 60 48" aria-hidden="true">
                    <path d={d.waveD} />
                    <path class="day__sea" d="M2 46 H58" />
                  </svg>
                  <span class="day__h data" set:html={d.heightHtml} />
                  <span class="day__wind" title={d.windLabel || undefined}>
                    {d.gone ? (
                      ''
                    ) : (
                      <>
                        <svg viewBox="0 0 20 20" style={`transform:rotate(${(d.windDir + 180) % 360}deg)`} aria-hidden="true">
                          <path d="M10 17V3M5 8l5-5 5 5" />
                        </svg>
                        {d.windLabel}
                      </>
                    )}
                  </span>
                  <span class="day__dots" aria-hidden="true">{dots}</span>
                  <span class="day__rate">{d.rateLabel}</span>
                </button>
              );
            })
          }
        </div>
      </div>

      <div class="log__detail" data-detail hidden={!prepared}>
        <p class="log__detail-title" data-detail-title>{prepared?.detail.title ?? ''}</p>
        <dl>
          <div>
            <dt class="eyebrow"><Sketch name="wave" />{t['week.swell']}</dt>
            <dd data-d-swell>{prepared?.detail.swell ?? ''}</dd>
          </div>
          <div>
            <dt class="eyebrow"><Sketch name="wind" />{t['week.wind']}</dt>
            <dd data-d-wind>{prepared?.detail.wind ?? ''}</dd>
          </div>
          <div>
            <dt class="eyebrow"><Sketch name="tide" />{t['week.tide']}</dt>
            <dd data-d-tide>{prepared?.detail.tide ?? ''}</dd>
          </div>
        </dl>
      </div>

      <p class="log__note hand">{t['week.note']}</p>
      {prepared?.source ? <p class="log__source">{prepared.source}</p> : <p class="log__source" data-source-empty hidden></p>}
    </div>

    <SeasonChart lang={lang} t={t} />
  </div>
</section>

<script>
  import {
    compass,
    detailForDay,
    prepareWeek,
    type ForecastDay,
    type WeekLogI18n,
    type WeekPayload,
  } from '../utils/week-forecast';

  async function loadWeek(): Promise<WeekPayload> {
    const urls = ['/api/week-forecast.php', '/data/week-forecast.json'];
    for (const url of urls) {
      try {
        const res = await fetch(url, { cache: 'no-cache' });
        if (!res.ok) continue;
        const json = (await res.json()) as WeekPayload;
        if (Array.isArray(json.days) && json.days.some((d) => d.score != null)) return json;
      } catch {
        /* try next */
      }
    }
    throw new Error('forecast');
  }

  async function run() {
    const root = document.querySelector<HTMLElement>('[data-surf-log]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const lang = root.dataset.lang === 'es' ? 'es' : 'en';
    const locale = root.dataset.locale || 'en-US';
    const t = JSON.parse(root.dataset.i18n || '{}') as WeekLogI18n;
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    try {
      const week = await loadWeek();
      // Freshness is for SSR only; the live fetch always wins when it has scored days.
      const prepared = prepareWeek({ ...week, generatedAt: new Date().toISOString() }, lang, locale, t);
      if (!prepared) throw new Error('empty');

      const sourceEl = root.querySelector<HTMLElement>('.log__source');
      if (sourceEl) {
        sourceEl.hidden = false;
        sourceEl.removeAttribute('data-source-empty');
        sourceEl.textContent = prepared.source;
      }

      $('[data-range]').textContent = prepared.range;
      $('[data-answer]').innerHTML = prepared.answerHtml;

      const detail = $('[data-detail]');
      function show(d: ForecastDay, fromClick = false) {
        const view = detailForDay(d, locale, t);
        detail.hidden = false;
        $('[data-detail-title]').textContent = view.title;
        $('[data-d-swell]').textContent = view.swell;
        $('[data-d-wind]').textContent = view.wind;
        $('[data-d-tide]').textContent = view.tide;
        if (!fromClick) return;
        detail.classList.remove('is-fresh');
        void detail.offsetWidth;
        detail.classList.add('is-fresh');
      }

      const wrap = $('[data-days]');
      wrap.innerHTML = '';
      prepared.days.forEach((d) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day${d.isBest ? ' day--best is-selected' : ''}${d.gone ? ' day--gone' : ''}`;
        btn.setAttribute('role', 'listitem');
        btn.setAttribute('aria-pressed', String(d.isBest));
        btn.dataset.date = d.date;
        const dots =
          d.rating < 0 ? '' : Array.from({ length: 4 }, (_, k) => `<i class="${k <= d.rating ? 'on' : ''}"></i>`).join('');
        btn.innerHTML = `
          ${d.isBest ? `<svg class="day__circle" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true"><path d="M70 6C40-2 8 14 6 60s14 76 46 74 46-30 42-72S74 4 44 10"/></svg><span class="day__best hand">${t.best}</span>` : ''}
          <span class="day__dow">${d.dow}</span>
          <span class="day__num">${d.dayNum}</span>
          <svg class="day__wave" viewBox="0 0 60 48" aria-hidden="true"><path d="${d.waveD}"/><path class="day__sea" d="M2 46 H58"/></svg>
          <span class="day__h data">${d.heightHtml}</span>
          <span class="day__wind" title="${d.windLabel}">${
            d.gone
              ? ''
              : `<svg viewBox="0 0 20 20" style="transform:rotate(${(d.windDir + 180) % 360}deg)" aria-hidden="true"><path d="M10 17V3M5 8l5-5 5 5"/></svg>${compass(d.windDir)}`
          }</span>
          <span class="day__dots" aria-hidden="true">${dots}</span>
          <span class="day__rate">${d.rateLabel}</span>`;
        if (!d.gone) {
          btn.addEventListener('click', () => {
            wrap.querySelectorAll('.day').forEach((el) => {
              el.classList.remove('is-selected');
              el.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-pressed', 'true');
            show(d, true);
            btn.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
          });
        } else {
          btn.disabled = true;
        }
        wrap.append(btn);
      });
      show(prepared.top);
      root.classList.add('is-live');
      root.querySelector<HTMLElement>('[data-surfline-fallback]')?.remove();
      const bestEl = wrap.querySelector<HTMLElement>('.day--best');
      const scroller = root.querySelector<HTMLElement>('.log__days-wrap');
      if (bestEl && scroller && scroller.scrollWidth > scroller.clientWidth) {
        scroller.scrollLeft = Math.max(0, bestEl.offsetLeft - scroller.clientWidth / 2 + bestEl.offsetWidth / 2);
      }
    } catch {
      delete root.dataset.ready;
      // Keep Surfline fallback visible when the blend cannot load.
      if (!root.querySelector('[data-surfline-fallback]')) {
        const answer = root.querySelector('[data-answer]');
        const fallback = document.createElement('p');
        fallback.className = 'log__fallback';
        fallback.dataset.surflineFallback = '';
        fallback.innerHTML = `<a class="pen-link" href="https://www.surfline.com/surf-report/la-saladita/584204204e65fad6a770921e" target="_blank" rel="noopener noreferrer">${
          lang === 'es' ? 'Abrir Surfline · La Saladita' : 'Open Surfline · La Saladita'
        } →</a>`;
        answer?.after(fallback);
      }
    }
  }

  run();
  document.addEventListener('astro:page-load', run);
</script>

<style is:global>
  .log__page {
    position: relative;
    padding: 1.4rem 1.1rem 1.25rem;
    background-color: var(--paper-3);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
    border: 1px solid rgba(43, 34, 29, 0.12);
    box-shadow: var(--shadow-lift);
    transform: rotate(-0.4deg);
  }

  .log__tape {
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .log__range {
    min-height: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .log__answer {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    max-width: 22ch;
    margin: 0.3rem 0 1.4rem;
    text-wrap: balance;
  }

  .log:not(:has(.is-live)) .log__answer {
    font-size: 1.15rem;
    font-weight: 500;
    max-width: 44ch;
    margin-bottom: 0.55rem;
  }

  .log__fallback {
    margin: 0 0 1.2rem;
  }

  .log__days-wrap {
    position: relative;
    overflow: visible;
  }

  .log__days {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 1.65rem 0 0.6rem;
  }

  .day {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.55rem 0.3rem 0.5rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-hand);
    background: transparent;
    color: var(--ink);
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .day:hover:not(:disabled) {
    background: rgba(231, 213, 180, 0.45);
  }

  .day.is-selected {
    background: rgba(248, 206, 101, 0.28);
    border-color: rgba(43, 34, 29, 0.35);
  }

  .day:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .day__circle {
    position: absolute;
    inset: -0.35rem -0.2rem -0.2rem;
    width: auto;
    height: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    pointer-events: none;
    overflow: visible;
  }

  .day__best {
    position: absolute;
    top: -1.2rem;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg);
    font-size: clamp(0.85rem, 3.2vw, 1.15rem);
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
  }

  .day__dow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pencil);
  }

  .day__num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
  }

  .day__wave {
    width: 3.4rem;
    height: 2.8rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__sea {
    stroke: var(--taupe);
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .day__h {
    font-size: 1.35rem;
  }

  .day__h small {
    font-family: var(--font-data);
    font-size: 0.65em;
    font-weight: 400;
    margin-left: 0.1rem;
    color: inherit;
  }

  .day__wind {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink);
    min-height: 1rem;
  }

  .day__wind svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__dots {
    display: flex;
    gap: 3px;
    min-height: 6px;
  }

  .day__dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.2px solid var(--ink);
  }

  .day__dots i.on {
    background: var(--ink);
    border-color: var(--ink);
  }

  .day__rate {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    color: var(--pencil);
  }

  .log:has(.is-live) .hl {
    background-size: 0% 0.62em;
    animation: markerSwipe 0.55s var(--ease-out) forwards;
  }

  .log__detail.is-fresh dd {
    animation: readUpdate 0.55s var(--ease-out);
  }

  @keyframes markerSwipe {
    to {
      background-size: 100% 0.62em;
    }
  }

  @keyframes readUpdate {
    from {
      background-color: var(--marker);
    }

    to {
      background-color: transparent;
    }
  }

  .log__detail {
    margin-top: 0.8rem;
    padding: 0.9rem 1rem;
    background: var(--paper);
    border: 1.5px solid var(--sr-card-line);
    border-radius: var(--radius);
  }

  .log__detail-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .log__detail dl {
    display: grid;
    gap: 0.45rem;
  }

  .log__detail dl div {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .log__detail dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .log__detail dt .sketch {
    width: 1.6rem;
    flex: none;
  }

  .log__detail dd {
    margin: 0;
    font-size: 0.98rem;
  }

  .log__note {
    margin-top: 1rem;
    font-size: 1.35rem;
    transform: rotate(-1deg);
    max-width: 34rem;
  }

  .log__source {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--pencil);
  }

  @media (min-width: 640px) {
    .log__days {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 0.5rem;
      padding-top: 1.5rem;
    }

    .day__circle {
      inset: -0.5rem -0.35rem -0.3rem;
    }

    .day__best {
      top: -1.45rem;
      font-size: 1.2rem;
    }
  }

  @media (min-width: 800px) {
    .log__page {
      padding: 2rem 2rem 1.6rem;
    }

    .log__days {
      gap: 0.6rem;
    }

    .log__detail {
      max-width: 34rem;
    }
  }
</style>
