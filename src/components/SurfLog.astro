---
/* "This week's log": best morning at the Saladita point from Surfline + surf-forecast
   (averaged), with Open-Meteo tide fill. Static month strip stays for SEO. */
import Sketch from './Sketch.astro';
import type { Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const locale = lang === 'es' ? 'es-MX' : 'en-US';
const monthFmt = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
// 1 = small, 2 = medium, 3 = best (from local experience, not a model)
const waves = [1, 1, 1, 2, 3, 3, 3, 3, 3, 2, 1, 1];
const crowd = [3, 3, 3, 2, 1, 1, 1, 1, 1, 1, 3, 3];
const months = waves.map((w, i) => ({
  name: monthFmt.format(new Date(Date.UTC(2026, i, 15))).replace('.', ''),
  waves: w,
  crowd: crowd[i],
}));

const i18n = {
  best: t['week.best'],
  window: t['week.window'],
  answer: t['week.answer'],
  swell: t['week.swell'],
  wind: t['week.wind'],
  tide: t['week.tide'],
  offshore: t['week.offshore'],
  cross: t['week.cross'],
  onshore: t['week.onshore'],
  glassy: t['week.glassy'],
  low: t['week.tideLow'],
  mid: t['week.tideMid'],
  high: t['week.tideHigh'],
  rising: t['week.rising'],
  falling: t['week.falling'],
  ratings: [t['week.r1'], t['week.r2'], t['week.r3'], t['week.r4']],
  gone: t['week.gone'],
  source: t['week.source'],
};
---

<section class="section log" id="section-surf" aria-labelledby="log-title">
  <div class="container">
    <div class="section__header">
      <p class="section__kicker hand"><Sketch name="wave" />{t['week.kicker']}</p>
      <h2 id="log-title" set:html={t['week.title']} />
      <p class="section__lead">{t['week.lead']}</p>
    </div>

    <div class="log__page" data-surf-log data-lang={lang} data-locale={locale} data-i18n={JSON.stringify(i18n)}>
      <span class="tape log__tape" aria-hidden="true"></span>
      <p class="log__range hand" data-range></p>
      <p class="log__answer" data-answer aria-live="polite">{t['week.unavailable']}</p>

      <div class="log__days-wrap">
        <div class="log__days" data-days role="list" aria-label={t['week.daysLabel']}></div>
      </div>

      <div class="log__detail" data-detail hidden>
        <p class="log__detail-title" data-detail-title></p>
        <dl>
          <div><dt><Sketch name="wave" />{t['week.swell']}</dt><dd data-d-swell></dd></div>
          <div><dt><Sketch name="wind" />{t['week.wind']}</dt><dd data-d-wind></dd></div>
          <div><dt><Sketch name="tide" />{t['week.tide']}</dt><dd data-d-tide></dd></div>
        </dl>
      </div>

      <p class="log__note hand">{t['week.note']}</p>
      <p class="log__source">{t['week.source']}</p>
    </div>

    <div class="season">
      <h3 class="season__title">{t['season.title']}</h3>
      <p class="season__summary">{t['season.summary']}</p>
      <div class="season__chart" role="table" aria-label={t['season.title']}>
        <div class="season__labels" aria-hidden="true">
          <span></span>
          <span class="season__label hand">{t['season.waves']}</span>
          <span class="season__label hand">{t['season.crowd']}</span>
        </div>
        <div class="season__months">
          {
            months.map((m) => (
              <div class="season__month" tabindex="0">
                <span class="season__mname">{m.name}</span>
                <span class={`season__wave season__wave--${m.waves}`}>
                  <span class="sr-only">{m.name}: {t[`season.level${m.waves}`]}</span>
                  <svg viewBox="0 0 24 30" aria-hidden="true">
                    <path d={m.waves === 3 ? 'M2 28C4 10 12 2 22 4c-6 4-8 10-6 16' : m.waves === 2 ? 'M2 28c3-10 9-15 18-14-4 3-5 7-4 10' : 'M2 28c3-5 8-8 16-7-3 2-4 4-3 6'} />
                  </svg>
                </span>
                <span class="season__crowd">
                  <span class="sr-only">{m.name}: {t[`season.crowd${m.crowd}`]}</span>
                  {Array.from({ length: m.crowd }).map(() => <i aria-hidden="true" />)}
                </span>
              </div>
            ))
          }
        </div>
      </div>
      <p class="season__foot hand">{t['season.foot']}</p>
    </div>
  </div>
</section>

<script>
  type Day = {
    date: string;
    score: number | null;
    start: number;
    swell: number;
    period: number;
    swellDir: number;
    windSpeed: number;
    windDir: number;
    windKind: 'offshore' | 'cross' | 'onshore' | 'glassy';
    tideLevel: number;
    tideRising: boolean;
  };

  type WeekPayload = {
    bestDate: string | null;
    sourcesUsed?: string[];
    days: Day[];
  };

  const clamp = (v: number, lo = 0, hi = 1) => Math.max(lo, Math.min(hi, v));
  const compass = (deg: number) => ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.round(((deg % 360) + 360) % 360 / 45) % 8];

  function wavePath(height: number) {
    const amp = 4 + clamp(height / 3) * 22;
    const base = 44;
    return `M2 ${base} C 10 ${base - amp * 0.4}, 16 ${base - amp}, 26 ${base - amp} C 36 ${base - amp}, 40 ${base - amp * 0.35}, 34 ${base - amp * 0.2} C 42 ${base - amp * 0.1}, 50 ${base}, 58 ${base}`;
  }

  function sourceLabel(sources: string[] = [], lang: string) {
    const names =
      lang === 'es'
        ? { surfline: 'Surfline', 'surf-forecast': 'surf-forecast', windy: 'Windy', 'open-meteo': 'Open-Meteo' }
        : { surfline: 'Surfline', 'surf-forecast': 'surf-forecast', windy: 'Windy', 'open-meteo': 'Open-Meteo' };
    const list = sources.map((s) => names[s as keyof typeof names] || s);
    if (!list.length) return lang === 'es' ? 'fuentes locales' : 'local sources';
    if (list.length === 1) return list[0];
    if (list.length === 2) return lang === 'es' ? `${list[0]} y ${list[1]}` : `${list[0]} and ${list[1]}`;
    return lang === 'es' ? `${list.slice(0, -1).join(', ')} y ${list.at(-1)}` : `${list.slice(0, -1).join(', ')}, and ${list.at(-1)}`;
  }

  async function loadWeek(): Promise<WeekPayload> {
    const urls = ['/api/week-forecast.php', '/data/week-forecast.json'];
    for (const url of urls) {
      try {
        const res = await fetch(url, { cache: 'no-cache' });
        if (!res.ok) continue;
        const json = (await res.json()) as WeekPayload;
        if (Array.isArray(json.days) && json.days.some((d) => d.score != null)) return json;
      } catch {
        /* try next */
      }
    }
    throw new Error('forecast');
  }

  async function run() {
    const root = document.querySelector<HTMLElement>('[data-surf-log]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const lang = root.dataset.lang === 'es' ? 'es' : 'en';
    const locale = root.dataset.locale || 'en-US';
    const t = JSON.parse(root.dataset.i18n || '{}');
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

    try {
      const week = await loadWeek();
      const days = week.days.map((d) => ({
        ...d,
        windKind: (d.windKind || 'glassy') as Day['windKind'],
        swellDir: d.swellDir || 210,
        tideLevel: d.tideLevel ?? 0.5,
        tideRising: d.tideRising ?? true,
      }));
      const scored = days.filter((d) => d.score != null);
      if (!scored.length) throw new Error('empty');
      const top =
        days.find((d) => d.date === week.bestDate && d.score != null) ||
        scored.reduce((a, b) => ((b.score ?? 0) > (a.score ?? 0) ? b : a));

      const sourceEl = root.querySelector('.log__source');
      if (sourceEl && t.source) {
        sourceEl.textContent = String(t.source).replace('{sources}', sourceLabel(week.sourcesUsed || [], lang));
      }

      const dFmt = (iso: string, o: Intl.DateTimeFormatOptions) =>
        new Intl.DateTimeFormat(locale, { ...o, timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
      const windowLabel = (d: Day) => (d.start + 3 < 12 ? `${d.start}–${d.start + 3} am` : `${d.start} am–12 pm`);
      const ft = (mtr: number) => Math.round(mtr * 3.28);
      const rating = (s: number) => (s >= 85 ? 3 : s >= 72 ? 2 : s >= 58 ? 1 : 0);

      $('[data-range]').textContent = `${dFmt(days[0].date, { month: 'short', day: 'numeric' })} – ${dFmt(days[days.length - 1].date, { month: 'short', day: 'numeric' })}`;
      $('[data-answer]').innerHTML = t.answer
        .replace('{day}', `<span class="hl">${dFmt(top.date, { weekday: 'long', month: 'short', day: 'numeric' })}</span>`)
        .replace('{window}', windowLabel(top));

      const detail = $('[data-detail]');
      function show(d: Day, fromClick = false) {
        detail.hidden = false;
        $('[data-detail-title]').textContent = `${dFmt(d.date, { weekday: 'long', month: 'short', day: 'numeric' })} · ${t.window} ${windowLabel(d)}`;
        $('[data-d-swell]').textContent = `${Number(d.swell).toFixed(1)} m (${ft(d.swell)} ft) · ${Math.round(d.period)} s · ${compass(d.swellDir)}`;
        $('[data-d-wind]').textContent = `${Math.round(d.windSpeed)} km/h ${compass(d.windDir)} · ${t[d.windKind]}`;
        const lvl = d.tideLevel < 0.34 ? t.low : d.tideLevel < 0.67 ? t.mid : t.high;
        $('[data-d-tide]').textContent = `${lvl}, ${d.tideRising ? t.rising : t.falling}`;
        if (!fromClick) return;
        detail.classList.remove('is-fresh');
        void detail.offsetWidth;
        detail.classList.add('is-fresh');
      }

      const wrap = $('[data-days]');
      wrap.innerHTML = '';
      days.forEach((d) => {
        const isBest = d.date === top.date;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `day${isBest ? ' day--best is-selected' : ''}${d.score == null ? ' day--gone' : ''}`;
        btn.setAttribute('role', 'listitem');
        btn.setAttribute('aria-pressed', String(isBest));
        const r = d.score == null ? -1 : rating(d.score);
        const dots = r < 0 ? '' : Array.from({ length: 4 }, (_, k) => `<i class="${k <= r ? 'on' : ''}"></i>`).join('');
        btn.innerHTML = `
          ${isBest ? `<svg class="day__circle" viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true"><path d="M70 6C40-2 8 14 6 60s14 76 46 74 46-30 42-72S74 4 44 10"/></svg><span class="day__best hand">${t.best}</span>` : ''}
          <span class="day__dow">${dFmt(d.date, { weekday: 'short' })}</span>
          <span class="day__num">${dFmt(d.date, { day: 'numeric' })}</span>
          <svg class="day__wave" viewBox="0 0 60 48" aria-hidden="true"><path d="${d.score == null ? 'M2 44 H58' : wavePath(d.swell)}"/><path class="day__sea" d="M2 46 H58"/></svg>
          <span class="day__h">${d.score == null ? '—' : `${Number(d.swell).toFixed(1)}<small>m</small>`}</span>
          <span class="day__wind" title="${compass(d.windDir)}">${d.score == null ? '' : `<svg viewBox="0 0 20 20" style="transform:rotate(${(d.windDir + 180) % 360}deg)" aria-hidden="true"><path d="M10 17V3M5 8l5-5 5 5"/></svg>${compass(d.windDir)}`}</span>
          <span class="day__dots" aria-hidden="true">${dots}</span>
          <span class="day__rate hand">${d.score == null ? t.gone : t.ratings[r]}</span>`;
        if (d.score != null) {
          btn.addEventListener('click', () => {
            wrap.querySelectorAll('.day').forEach((el) => {
              el.classList.remove('is-selected');
              el.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-selected');
            btn.setAttribute('aria-pressed', 'true');
            show(d, true);
            btn.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
          });
        } else {
          btn.disabled = true;
        }
        wrap.append(btn);
      });
      show(top);
      root.classList.add('is-live');
      const bestEl = wrap.querySelector<HTMLElement>('.day--best');
      const scroller = root.querySelector<HTMLElement>('.log__days-wrap');
      if (bestEl && scroller && scroller.scrollWidth > scroller.clientWidth) {
        scroller.scrollLeft = Math.max(0, bestEl.offsetLeft - scroller.clientWidth / 2 + bestEl.offsetWidth / 2);
      }
    } catch {
      delete root.dataset.ready;
    }
  }

  run();
  document.addEventListener('astro:page-load', run);
</script>

<style is:global>
  .log__page {
    position: relative;
    padding: 1.4rem 1.1rem 1.25rem;
    background-color: var(--paper-3);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
    border: 1px solid rgba(21, 52, 72, 0.12);
    box-shadow: var(--shadow-lift);
    transform: rotate(-0.4deg);
  }

  .log__tape {
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
  }

  .log__range {
    font-size: 1.5rem;
    color: var(--pencil);
    min-height: 1.6rem;
  }

  .log__answer {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    max-width: 22ch;
    margin: 0.3rem 0 1.4rem;
    text-wrap: balance;
  }

  .log:not(:has(.is-live)) .log__answer {
    font-size: 1.15rem;
    font-weight: 500;
    max-width: 44ch;
  }

  .log__days-wrap {
    position: relative;
    margin-inline: -1.1rem;
    padding-inline: 1.1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .log__days-wrap::-webkit-scrollbar {
    display: none;
  }

  .log__days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5.2rem;
    gap: 0.4rem;
    padding: 1.5rem 0.2rem 0.6rem;
  }

  .day {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.55rem 0.3rem 0.5rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-hand);
    background: transparent;
    color: var(--ink);
    transition: background-color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .day:hover:not(:disabled) {
    background: rgba(231, 216, 192, 0.45);
  }

  .day.is-selected {
    background: rgba(241, 210, 122, 0.28);
    border-color: rgba(21, 52, 72, 0.35);
  }

  .day:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .day__circle {
    position: absolute;
    inset: -0.6rem -0.45rem -0.4rem;
    width: calc(100% + 0.9rem);
    height: calc(100% + 1rem);
    fill: none;
    stroke: #c0392b;
    stroke-width: 2.2;
    stroke-linecap: round;
    pointer-events: none;
    overflow: visible;
  }

  .day__best {
    position: absolute;
    top: -1.55rem;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg);
    font-size: 1.25rem;
    font-weight: 700;
    color: #b0342a;
    white-space: nowrap;
  }

  .day__dow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pencil);
  }

  .day__num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
  }

  .day__wave {
    width: 3.4rem;
    height: 2.8rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__sea {
    stroke: var(--taupe);
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .day__h {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .day__h small {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    margin-left: 0.1rem;
    color: var(--pencil);
  }

  .day__wind {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
    min-height: 1rem;
  }

  .day__wind svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .day__dots {
    display: flex;
    gap: 3px;
    min-height: 6px;
  }

  .day__dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.2px solid var(--ink-2);
  }

  .day__dots i.on {
    background: var(--ink);
    border-color: var(--ink);
  }

  .day__rate {
    font-size: 1.1rem;
    line-height: 1;
  }

  .log.is-live .hl {
    background-size: 0% 0.62em;
    animation: markerSwipe 0.55s var(--ease-out) forwards;
  }

  .log__detail.is-fresh dd {
    animation: readUpdate 0.55s var(--ease-out);
  }

  @keyframes markerSwipe {
    to {
      background-size: 100% 0.62em;
    }
  }

  @keyframes readUpdate {
    from {
      background-color: var(--marker);
    }

    to {
      background-color: transparent;
    }
  }

  .log__detail {
    margin-top: 0.8rem;
    padding: 0.9rem 1rem;
    background: var(--paper-3);
    border: 1.5px dashed rgba(21, 52, 72, 0.4);
    border-radius: 4px;
  }

  .log__detail-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .log__detail dl {
    display: grid;
    gap: 0.45rem;
  }

  .log__detail dl div {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    gap: 0.5rem;
    align-items: center;
  }

  .log__detail dt {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pencil);
  }

  .log__detail dt .sketch {
    width: 1.6rem;
    flex: none;
  }

  .log__detail dd {
    margin: 0;
    font-size: 0.98rem;
  }

  .log__note {
    margin-top: 1rem;
    font-size: 1.35rem;
    transform: rotate(-1deg);
    max-width: 34rem;
  }

  .log__source {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--pencil);
  }

  /* Season strip */
  .season {
    margin-top: 3rem;
  }

  .season__title {
    font-size: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .season__summary {
    max-width: 44rem;
    margin-bottom: 1.2rem;
  }

  .season__chart {
    display: grid;
    grid-template-columns: 4.3rem minmax(0, 1fr);
    gap: 0.35rem;
    overflow-x: auto;
    padding-bottom: 0.6rem;
  }

  .season__labels {
    display: grid;
    grid-template-rows: 1.1rem 2.4rem auto;
    align-items: end;
    gap: 0.2rem;
  }

  .season__months {
    display: grid;
    grid-template-columns: repeat(12, minmax(2.1rem, 1fr));
    gap: 2px;
  }

  .season__month {
    display: grid;
    grid-template-rows: 1.1rem 2.4rem auto;
    align-items: end;
    gap: 0.2rem;
    border-radius: 10px 10px 4px 4px;
    transition: transform 0.35s var(--ease-out);
  }

  .season__month:hover,
  .season__month:focus-visible {
    transform: translateY(-10px);
    z-index: 1;
    outline: none;
  }

  .season__mname {
    font-size: clamp(0.56rem, 2.2vw, 0.72rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pencil);
    text-align: center;
  }

  .season__label {
    font-size: 1.1rem;
    align-self: center;
  }

  .season__wave {
    display: grid;
    place-items: end center;
    height: 2.4rem;
    border-bottom: 1.5px solid var(--taupe);
  }

  .season__wave svg {
    width: min(1.3rem, 80%);
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .season__wave--1 svg {
    stroke: var(--taupe);
  }

  .season__wave--3 {
    background: linear-gradient(to top, rgba(241, 210, 122, 0.45), transparent 75%);
  }

  .season__crowd {
    display: flex;
    justify-content: center;
    gap: 1px;
    padding-top: 0.4rem;
  }

  .season__crowd i {
    width: 5px;
    height: 10px;
    border-radius: 3px 3px 1px 1px;
    background: var(--ink-2);
  }

  .season__foot {
    margin-top: 0.6rem;
    font-size: 1.3rem;
  }

  @media (min-width: 800px) {
    .log__page {
      padding: 2rem 2rem 1.6rem;
    }

    .log__days-wrap {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .log__days {
      grid-auto-flow: unset;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-columns: unset;
      gap: 0.6rem;
    }

    .log__detail {
      max-width: 34rem;
    }
  }
</style>
