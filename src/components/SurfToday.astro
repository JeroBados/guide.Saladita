---
import type { Lang } from '../utils/i18n';
import type { SurfSpot } from '../types/surf-spot';
import { buildWhatsAppUrl } from '../utils/wa';
import { getForecastPageUrl, getForecastWidgetUrl } from '../utils/surf';

interface Props {
  lang: Lang;
  titleHtml: string;
  forecastLabel: string;
  pickSpotLabel: string;
  waterTempLabel: string;
  waterTempValue: string;
  seasonLabel: string;
  seasonValue: string;
  bookLessonLabel: string;
  lessonWaText: string;
  stayCtaLabel: string;
  stayCtaUrl: string;
  spots: SurfSpot[];
}

const {
  lang,
  titleHtml,
  forecastLabel,
  pickSpotLabel,
  waterTempLabel,
  waterTempValue,
  seasonLabel,
  seasonValue,
  bookLessonLabel,
  lessonWaText,
  stayCtaLabel,
  stayCtaUrl,
  spots,
} = Astro.props;

const defaultSpot = spots[0];
const forecastConfig = JSON.stringify(
  spots.map((spot) => ({
    id: spot.id,
    slug: spot.forecastSlug,
    name: spot.name[lang],
    widgetUrl: getForecastWidgetUrl(spot.forecastSlug),
    pageUrl: getForecastPageUrl(spot.forecastSlug, lang),
  })),
);
const lessonUrl = buildWhatsAppUrl(lessonWaText);
const surflineUrl = 'https://www.surfline.com/surf-report/la-saladita-guerrero-mexico/5842041f4e65fad6a7703db1';
---

<section class="surf-today section section--dark" aria-labelledby="surf-today-title">
  <div class="container">
    <div class="section__header reveal">
      <h2 id="surf-today-title" set:html={titleHtml} />
    </div>

    <div class="surf-today__meta reveal">
      <p class="surf-today__chip">{waterTempLabel}: {waterTempValue}</p>
      <p class="surf-today__chip">{seasonLabel}: {seasonValue}</p>
    </div>

    <div class="surf-today__forecast reveal" data-surf-forecast>
      <p class="surf-today__pick">{pickSpotLabel}</p>
      <div class="surf-today__tabs" role="tablist">
        {
          spots.map((spot, index) => (
            <button
              class:list={['surf-today__tab', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              data-spot-tab={spot.id}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              {spot.name[lang]}
            </button>
          ))
        }
      </div>

      <p class="surf-today__active-name" data-spot-name>{defaultSpot.name[lang]}</p>

      <iframe
        class="surf-today__iframe"
        data-spot-iframe
        src={getForecastWidgetUrl(defaultSpot.forecastSlug)}
        title={defaultSpot.name[lang]}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />

      <a
        class="surf-today__forecast-link"
        data-spot-link
        href={getForecastPageUrl(defaultSpot.forecastSlug, lang)}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="surf-forecast"
        data-cta-type="link"
      >
        {forecastLabel}
      </a>
    </div>

    <div class="surf-today__actions reveal">
      <a
        class="surf-today__cta"
        href={lessonUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="surf-lesson"
        data-cta-type="whatsapp"
      >
        {bookLessonLabel}
      </a>
      <a
        class="surf-today__cta surf-today__cta--secondary"
        href={stayCtaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id="surf-stay-cta"
        data-cta-type="link"
      >
        {stayCtaLabel}
      </a>
      <a
        class="surf-today__surfline"
        href={surflineUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Surfline ↗
      </a>
    </div>
  </div>
</section>

<script type="application/json" id="surf-forecast-config" set:html={forecastConfig} />

<script>
  function initSurfForecastTabs() {
    const root = document.querySelector('[data-surf-forecast]');
    const configEl = document.getElementById('surf-forecast-config');
    if (!root || !configEl || root.dataset.ready === 'true') return;

    let spots = [];
    try {
      spots = JSON.parse(configEl.textContent || '[]');
    } catch {
      return;
    }

    const iframe = root.querySelector('[data-spot-iframe]');
    const nameEl = root.querySelector('[data-spot-name]');
    const linkEl = root.querySelector('[data-spot-link]');
    const tabs = root.querySelectorAll('[data-spot-tab]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-spot-tab');
        const spot = spots.find((s) => s.id === id);
        if (!spot || !iframe) return;

        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        iframe.setAttribute('src', spot.widgetUrl);
        iframe.setAttribute('title', spot.name);
        if (nameEl) nameEl.textContent = spot.name;
        if (linkEl) linkEl.setAttribute('href', spot.pageUrl);
      });
    });

    root.dataset.ready = 'true';
  }

  initSurfForecastTabs();
  document.addEventListener('astro:page-load', initSurfForecastTabs);
</script>

<style>
  .surf-today {
    background: var(--navy);
    color: var(--cream);
    padding-block: 2.5rem;
  }

  .surf-today__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .surf-today__chip {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-chip);
    background: rgba(164, 178, 176, 0.18);
    font-size: var(--text-small);
    color: var(--sand);
  }

  .surf-today__pick {
    font-size: var(--text-small);
    color: var(--sage);
    margin-bottom: 0.65rem;
  }

  .surf-today__tabs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    margin-bottom: 0.75rem;
    scrollbar-width: none;
  }

  .surf-today__tabs::-webkit-scrollbar {
    display: none;
  }

  .surf-today__tab {
    flex: 0 0 auto;
    min-height: var(--touch-min);
    padding: 0.65rem 1rem;
    border-radius: var(--radius-chip);
    border: 1px solid rgba(164, 178, 176, 0.45);
    background: transparent;
    color: var(--cream);
    font-size: var(--text-small);
    font-weight: 600;
    white-space: nowrap;
  }

  .surf-today__tab.is-active {
    background: var(--sand);
    color: var(--navy);
    border-color: var(--sand);
  }

  .surf-today__active-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin-bottom: 0.65rem;
  }

  .surf-today__iframe {
    width: 100%;
    min-height: 280px;
    border: 0;
    border-radius: var(--radius);
    background: rgba(240, 237, 230, 0.08);
  }

  .surf-today__forecast-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    margin-top: 0.85rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--sage);
    border-radius: var(--radius-chip);
    color: var(--cream);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .surf-today__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .surf-today__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0.95rem 1.25rem;
    border-radius: var(--radius-chip);
    background: var(--sand);
    color: var(--navy);
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
  }

  .surf-today__cta--secondary {
    background: transparent;
    border: 1px solid var(--sage);
    color: var(--cream);
    font-weight: 600;
    font-size: var(--text-small);
  }

  .surf-today__surfline {
    justify-self: start;
    font-size: var(--text-small);
    color: var(--sage);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
