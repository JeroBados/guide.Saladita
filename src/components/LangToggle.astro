---
import type { Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  altPath: string;
  label: string;
}

const { lang, altPath, label } = Astro.props;
---

<a
  class="lang-toggle"
  href={altPath}
  hreflang={lang === 'en' ? 'es' : 'en'}
  lang={lang === 'en' ? 'es' : 'en'}
  aria-label={lang === 'en' ? 'Ver en español' : 'View in English'}
>
  {label}
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3rem;
    min-height: 44px;
    padding: 0.35rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-hand);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
    transition: background-color 0.2s var(--ease-out);
  }

  .lang-toggle:hover {
    background: var(--sand);
  }
</style>
