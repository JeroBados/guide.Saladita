---
import type { Lang } from '../utils/i18n';
import { buildWhatsAppUrl } from '../utils/wa';
import packages from '../data/packages.json';

interface Pkg {
  id: string;
  featured?: boolean;
  name: { en: string; es: string };
  badge: { en: string; es: string };
  desc: { en: string; es: string };
  priceHint?: { en: string; es: string };
  waText: { en: string; es: string };
  link?: string;
}

interface Props {
  lang: Lang;
  titleHtml: string;
  lead: string;
  waLabel: string;
  webLabel: string;
}

const { lang, titleHtml, lead, waLabel, webLabel } = Astro.props;
const items = packages as Pkg[];
---

<section class="packages section section--alt" id="section-packages" aria-labelledby="packages-title">
  <div class="container">
    <div class="section__header reveal">
      <h2 id="packages-title" set:html={titleHtml} />
      <p class="section__lead">{lead}</p>
    </div>

    <div class="packages__list">
      {
        items.map((pkg, index) => (
          <article class:list={['package-card reveal', { 'package-card--featured': pkg.featured }]} style={`--i: ${index}`}>
            {pkg.featured && <span class="package-card__ribbon">{pkg.badge[lang]}</span>}
            <div class="package-card__head">
              {!pkg.featured && <span class="package-card__badge">{pkg.badge[lang]}</span>}
              <h3 class="package-card__name">{pkg.name[lang]}</h3>
              {pkg.priceHint && <p class="package-card__price">{pkg.priceHint[lang]}</p>}
            </div>
            <p class="package-card__desc">{pkg.desc[lang]}</p>
            <div class="package-card__actions">
              <a
                class="package-card__cta"
                href={buildWhatsAppUrl(pkg.waText[lang])}
                target="_blank"
                rel="noopener noreferrer"
                data-track-cta
                data-place-id={pkg.id}
                data-cta-type="whatsapp"
              >
                {waLabel}
              </a>
              {pkg.link && (
                <a
                  class="package-card__link"
                  href={pkg.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-cta
                  data-place-id={`${pkg.id}-web`}
                  data-cta-type="link"
                >
                  {webLabel}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .packages__list {
    display: grid;
    gap: 1rem;
  }

  .package-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid rgba(148, 137, 121, 0.25);
    box-shadow: var(--shadow-card);
  }

  .package-card--featured {
    border-color: var(--navy);
    background: var(--sand);
  }

  .package-card__ribbon {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-chip);
    background: var(--navy);
    color: var(--cream);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .package-card__badge {
    display: inline-block;
    margin-bottom: 0.35rem;
    font-size: var(--text-small);
    color: var(--taupe);
    font-weight: 600;
  }

  .package-card__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    padding-right: 4rem;
  }

  .package-card__price {
    font-size: var(--text-small);
    color: var(--navy);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .package-card__desc {
    font-size: var(--text-small);
    color: var(--taupe);
  }

  .package-card__actions {
    display: grid;
    gap: 0.65rem;
  }

  .package-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-chip);
    background: var(--navy);
    color: var(--cream);
    font-weight: 700;
    font-size: 1rem;
  }

  .package-card__link {
    text-align: center;
    font-size: var(--text-small);
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    min-height: var(--touch-min);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
