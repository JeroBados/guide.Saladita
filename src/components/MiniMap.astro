---
interface Props {
  title: string;
  embedUrl: string;
  openLabel: string;
  openUrl: string;
}

const { title, embedUrl, openLabel, openUrl } = Astro.props;
---

<section class="mini-map section" aria-labelledby="mini-map-title">
  <div class="container">
    <h2 id="mini-map-title" class="mini-map__title reveal">{title}</h2>
    <div class="mini-map__frame reveal">
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    </div>
    <a class="mini-map__open" href={openUrl} target="_blank" rel="noopener noreferrer">{openLabel}</a>
  </div>
</section>

<style>
  .mini-map {
    padding-block: 2rem;
  }

  .mini-map__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    margin-bottom: 1rem;
  }

  .mini-map__frame {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(148, 137, 121, 0.3);
    background: var(--sand);
  }

  .mini-map__frame iframe {
    display: block;
    width: 100%;
    height: 280px;
    border: 0;
  }

  .mini-map__open {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    margin-top: 0.85rem;
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
