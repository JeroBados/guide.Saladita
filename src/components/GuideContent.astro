---
import SurfLog from './SurfLog.astro';
import SurfSpotCard from './SurfSpotCard.astro';
import EatDay from './EatDay.astro';
import GuideNav from './GuideNav.astro';
import Sketch from './Sketch.astro';
import type { SketchName } from './Sketch.astro';
import type { Lang } from '../utils/i18n';
import { getSurfSpots } from '../utils/surf';
import { buildWhatsAppUrl } from '../utils/wa';

interface Props {
  lang: Lang;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const surfSpots = getSurfSpots();
const experiencesUrl = `https://lasaladitarentals.com/${lang === 'es' ? 'es' : 'en'}/experiences-in-la-saladita?utm_source=guide&utm_medium=tips`;
const askUrl = buildWhatsAppUrl(t['ask.message']);

const faqs: { key: string; icon: SketchName }[] = [
  { key: 'airport', icon: 'plane' },
  { key: 'cash', icon: 'cash' },
  { key: 'signal', icon: 'signal' },
  { key: 'water', icon: 'drop' },
  { key: 'season', icon: 'sun' },
  { key: 'beginner', icon: 'longboard' },
  { key: 'lessons', icon: 'board' },
  { key: 'firstday', icon: 'plate' },
  { key: 'safety', icon: 'shell' },
];
const faqItems = faqs.map((f) => ({ ...f, q: t[`faq.${f.key}.q`], a: t[`faq.${f.key}.a`] }));

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  dateModified: '2026-09-25',
  author: {
    '@type': 'Organization',
    name: 'Saladita Rentals',
    url: 'https://lasaladitarentals.com',
  },
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const navItems = [
  { id: 'surf', label: t['nav.surf'], href: '#section-surf' },
  { id: 'spots', label: t['nav.spots'], href: '#section-spots' },
  { id: 'eat', label: t['nav.eat'], href: '#section-eat' },
  { id: 'tips', label: t['nav.tips'], href: '#section-tips' },
];

const specLabels = {
  board: t['surf.spec.board'],
  level: t['surf.spec.level'],
  tide: t['surf.spec.tide'],
  wind: t['surf.spec.wind'],
  swell: t['surf.spec.swell'],
  access: t['surf.spec.access'],
  ride: t['surf.spec.ride'],
};
---

<GuideNav label={t['nav.label']} items={navItems} />

<main>
  <SurfLog lang={lang} t={t} />

  <section class="section section--alt" id="section-spots" aria-labelledby="spots-title">
    <div class="container">
      <div class="section__header">
        <p class="section__kicker hand"><Sketch name="board" />{t['surf.kicker']}</p>
        <h2 id="spots-title" set:html={t['surf.spots']} />
        <p class="section__lead">{t['surf.spotsLead']}</p>
      </div>
      <div class="spots">
        {surfSpots.map((spot, index) => <SurfSpotCard spot={spot} lang={lang} index={index} mapsLabel={t['place.openMaps']} labels={specLabels} />)}
      </div>

      <aside class="sticky-note" id="section-ask" aria-labelledby="ask-title">
        <span class="tape sticky-note__tape" aria-hidden="true"></span>
        <h2 id="ask-title" class="sticky-note__title">{t['ask.title']}</h2>
        <ul class="sticky-note__list">
          <li><strong>{t['ask.lessons.label']}</strong> {t['ask.lessons']}</li>
          <li><strong>{t['ask.transfer.label']}</strong> {t['ask.transfer']}</li>
          <li><strong>{t['ask.more.label']}</strong> <a class="pen-link" href={experiencesUrl} target="_blank" rel="noopener noreferrer">{t['ask.web']}</a></li>
        </ul>
        <a class="btn btn--ink" href={askUrl} target="_blank" rel="noopener noreferrer" data-track-cta data-place-id="ask-whatsapp" data-cta-type="whatsapp">{t['ask.cta']}</a>
      </aside>
    </div>
  </section>

  <section class="section" id="section-eat" aria-labelledby="eat-title">
    <div class="container">
      <div class="section__header">
        <p class="section__kicker hand"><Sketch name="plate" />{t['eat.kicker']}</p>
        <h2 id="eat-title" set:html={t['eat.title']} />
        <p class="section__lead">{t['eat.lead']}</p>
      </div>
      <EatDay lang={lang} t={t} />
    </div>
  </section>

  <section class="section section--alt" id="section-tips" aria-labelledby="tips-title">
    <div class="container">
      <div class="section__header">
        <p class="section__kicker hand"><Sketch name="sun" />{t['tips.kicker']}</p>
        <h2 id="tips-title" set:html={t['tips.title']} />
      </div>
      <div class="faq">
        {
          faqItems.map((item) => (
            <article class="faq__item" id={`faq-${item.key}`}>
              <Sketch name={item.icon} class="faq__icon" />
              <div>
                <h3>{item.q}</h3>
                <p>{item.a}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="signoff">
        <p class="signoff__text">{t['byline']}</p>
        <p class="signoff__sign hand">{t['byline.sign']}</p>
      </div>
    </div>
  </section>
</main>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .spots {
    display: grid;
    gap: 1.4rem;
  }

  @media (min-width: 900px) {
    .spots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: 1.25rem;
    }
  }

  /* Sticky note: lessons, boards, airport */
  .sticky-note {
    position: relative;
    margin: 3rem auto 0;
    max-width: 36rem;
    padding: 1.8rem 1.4rem 1.5rem;
    background: #f6dc8f;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.25), transparent 30%);
    box-shadow: 0 16px 26px -16px rgba(21, 52, 72, 0.45), 0 2px 0 rgba(21, 52, 72, 0.06);
    transform: rotate(-1.2deg);
  }

  .sticky-note__tape {
    top: -0.8rem;
    left: 50%;
    transform: translateX(-50%) rotate(2deg);
  }

  .sticky-note__title {
    font-family: var(--font-hand);
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
  }

  .sticky-note__list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin-bottom: 1.3rem;
    list-style: none;
  }

  .sticky-note__list li {
    padding-left: 1.3rem;
    position: relative;
    line-height: 1.5;
  }

  .sticky-note__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-family: var(--font-hand);
    font-size: 1.3rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .sticky-note .btn--ink {
    box-shadow: 3px 4px 0 rgba(21, 52, 72, 0.25);
  }

  /* FAQ — notebook Q&A */
  .faq {
    display: grid;
    gap: 0;
    max-width: 50rem;
  }

  .faq__item {
    display: grid;
    grid-template-columns: 2.8rem 1fr;
    gap: 0.9rem;
    padding-block: 1.3rem;
    border-top: 1.5px dashed rgba(21, 52, 72, 0.25);
  }

  .faq__item:last-child {
    border-bottom: 1.5px dashed rgba(21, 52, 72, 0.25);
  }

  .faq__item :global(.faq__icon) {
    width: 2.8rem;
    color: var(--ink-2);
    margin-top: 0.1rem;
  }

  .faq__item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }

  .faq__item p {
    max-width: 44rem;
  }

  .signoff {
    margin-top: 2.4rem;
    max-width: 40rem;
  }

  .signoff__text {
    font-size: 0.95rem;
    color: var(--pencil);
  }

  .signoff__sign {
    margin-top: 0.4rem;
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--ink);
    transform: rotate(-3deg);
    transform-origin: left;
  }

  @media (min-width: 900px) {
    .faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
      max-width: none;
    }

    .faq__item:nth-last-child(2) {
      border-bottom: 1.5px dashed rgba(21, 52, 72, 0.25);
    }
  }
</style>
