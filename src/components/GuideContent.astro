---
import WeekBoard from './WeekBoard.astro';
import SurfSpotCard from './SurfSpotCard.astro';
import PlaceCard from './PlaceCard.astro';
import GuideNav from './GuideNav.astro';
import Sketch from './Sketch.astro';
import type { Lang } from '../utils/i18n';
import { getEatPlaces } from '../utils/places';
import { getSurfSpots } from '../utils/surf';
import { buildWhatsAppUrl } from '../utils/wa';

interface Props {
  lang: Lang;
  t: Record<string, string>;
}

const { lang, t } = Astro.props;
const eatPlaces = getEatPlaces();
const surfSpots = getSurfSpots();
const experiencesUrl =
  lang === 'es'
    ? 'https://lasaladitarentals.com/en/experiences-in-la-saladita?utm_source=guide&utm_medium=tips'
    : 'https://lasaladitarentals.com/en/experiences-in-la-saladita?utm_source=guide&utm_medium=tips';
const askUrl = buildWhatsAppUrl(t['ask.message']);

const faqs = [
  { q: t['faq.airport.q'], a: t['faq.airport.a'] },
  { q: t['faq.cash.q'], a: t['faq.cash.a'] },
  { q: t['faq.signal.q'], a: t['faq.signal.a'] },
  { q: t['faq.water.q'], a: t['faq.water.a'] },
  { q: t['faq.season.q'], a: t['faq.season.a'] },
  { q: t['faq.safety.q'], a: t['faq.safety.a'] },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  dateModified: '2026-09-01',
  author: {
    '@type': 'Organization',
    name: 'Saladita Rentals',
    url: 'https://lasaladitarentals.com',
  },
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const navItems = [
  { id: 'surf', label: t['nav.surf'], href: '#section-surf' },
  { id: 'spots', label: t['nav.spots'], href: '#section-spots' },
  { id: 'eat', label: t['nav.eat'], href: '#section-eat' },
  { id: 'tips', label: t['nav.tips'], href: '#section-tips' },
];

const specLabels = {
  type: t['surf.spec.type'],
  board: t['surf.spec.board'],
  level: t['surf.spec.level'],
  tide: t['surf.spec.tide'],
  wind: t['surf.spec.wind'],
  swell: t['surf.spec.swell'],
  access: t['surf.spec.access'],
  ride: t['surf.spec.ride'],
};
---

<GuideNav label={t['nav.label']} items={navItems} />

<WeekBoard
  lang={lang}
  title={t['week.title']}
  note={t['week.note']}
  source={t['week.source']}
  unavailable={t['week.unavailable']}
/>

<section class="section" id="section-spots" aria-labelledby="spots-title">
  <div class="container">
    <div class="section__header section__header--draw">
      <Sketch name="wave" />
      <h2 id="spots-title" set:html={t['surf.spots']} />
      <p class="section__lead">{t['surf.spotsLead']}</p>
    </div>
    <div class="spot-list rail">
      {
        surfSpots.map((spot, index) => (
          <SurfSpotCard
            spot={spot}
            lang={lang}
            mapsLabel={t['place.openMaps']}
            labels={specLabels}
            revealIndex={index}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="section section--alt ask" id="section-ask">
  <div class="container ask__inner">
    <h2>{t['ask.title']}</h2>
    <p>{t['ask.body']}</p>
    <div class="ask__actions">
      <a class="ask__wa" href={askUrl} target="_blank" rel="noopener noreferrer">{t['ask.cta']}</a>
      <a class="ask__web" href={experiencesUrl} target="_blank" rel="noopener noreferrer">{t['ask.web']}</a>
    </div>
  </div>
</section>

<section class="section" id="section-eat" aria-labelledby="eat-title">
  <div class="container">
    <div class="section__header section__header--draw">
      <Sketch name="plate" />
      <h2 id="eat-title" set:html={t['eat.title']} />
      <p class="section__lead">{t['eat.lead']}</p>
    </div>
    <div class="card-grid rail">
      {
        eatPlaces.map((place, index) => (
          <PlaceCard
            place={place}
            lang={lang}
            directionsLabel={t['place.openMaps']}
            whatsappLabel={t['services.cta']}
            revealIndex={index}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="section section--alt" id="section-tips" aria-labelledby="tips-title">
  <div class="container">
    <div class="section__header section__header--draw">
      <Sketch name="sun" />
      <h2 id="tips-title" set:html={t['tips.title']} />
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq__item reveal">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>
    <p class="byline">{t['byline']}</p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .section__header--draw {
    display: grid;
    gap: 0.35rem;
    color: var(--navy);
  }

  .section__header--draw :global(.sketch) {
    width: 3.4rem;
  }

  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16.5rem, 78%);
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.2rem;
    padding-bottom: 0.6rem;
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail > :global(*) {
    scroll-snap-align: start;
  }

  @media (min-width: 800px) {
    .rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-columns: unset;
      overflow: visible;
    }
  }

  @media (min-width: 1100px) {
    .rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .section__lead {
    margin-top: 0.55rem;
    color: var(--taupe);
    font-size: var(--text-small);
    max-width: 38rem;
  }

  .section--alt {
    background: rgba(231, 216, 192, 0.4);
  }

  .spot-list,
  .faq {
    display: grid;
    gap: 1rem;
  }

  .ask__inner {
    display: grid;
    gap: 0.75rem;
  }

  .ask__inner p {
    max-width: 40rem;
    color: var(--taupe);
  }

  .ask__actions {
    display: grid;
    gap: 0.65rem;
  }

  .ask__wa,
  .ask__web {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-chip);
    font-weight: 700;
  }

  .ask__wa {
    background: var(--navy);
    color: var(--cream);
  }

  .ask__web {
    border: 1px solid var(--navy);
    color: var(--navy);
  }

  .faq__item {
    padding: 1.05rem 1.1rem;
    border-radius: 20px;
    background: #f7f4ee;
    border: 1px solid rgba(21, 52, 72, 0.08);
    box-shadow: var(--shadow-card);
  }

  .faq__item h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .faq__item p {
    color: var(--navy);
    max-width: 46rem;
  }

  .byline {
    margin-top: 1.25rem;
    font-size: var(--text-small);
    color: var(--taupe);
    max-width: 42rem;
  }

  @media (min-width: 640px) {
    .ask__actions {
      grid-template-columns: auto auto;
      justify-content: start;
    }

    .ask__wa,
    .ask__web {
      padding-inline: 1.2rem;
    }
  }
</style>
