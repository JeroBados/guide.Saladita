---
import Brand from './Brand.astro';
import type { Lang } from '../utils/i18n';
import { getTranslations } from '../utils/i18n';

interface Props {
  lang: Lang;
  shareLabel: string;
  tagline: string;
}

const { lang, shareLabel, tagline } = Astro.props;
const t = getTranslations(lang);
const whatsapp = 'https://wa.me/525611073849';
const instagram = 'https://instagram.com/saladitarentals';
const email = 'mailto:hello@lasaladitarentals.com';
const getThere = lang === 'es' ? '/es/como-llegar' : '/get-there';
const housesUrl =
  lang === 'es'
    ? 'https://lasaladitarentals.com/es?utm_source=guide&utm_medium=footer'
    : 'https://lasaladitarentals.com/?utm_source=guide&utm_medium=footer';
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <Brand tone="light" height={28} />
      <p class="footer__tagline">{tagline}</p>
      <p class="footer__hand hand">{lang === 'es' ? 'nos vemos en el agua' : 'see you in the water'}</p>
    </div>

    <nav class="footer__col" aria-label={lang === 'es' ? 'Explorar' : 'Explore'}>
      <p class="eyebrow footer__heading">{lang === 'es' ? 'Explorar' : 'Explore'}</p>
      <a href={getThere}>{t['footer.getThere']}</a>
      <a href={housesUrl} target="_blank" rel="noopener noreferrer">{t['footer.houses']}</a>
      <a href="https://lasaladitarentals.com" target="_blank" rel="noopener noreferrer">lasaladitarentals.com</a>
    </nav>

    <nav class="footer__col" aria-label={lang === 'es' ? 'Contacto' : 'Contact'}>
      <p class="eyebrow footer__heading">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track-cta data-place-id="footer-whatsapp" data-cta-type="whatsapp">WhatsApp</a>
      <a href={instagram} target="_blank" rel="noopener noreferrer" data-track-cta data-place-id="footer-instagram" data-cta-type="link">Instagram</a>
      <a href={email} data-track-cta data-place-id="footer-email" data-cta-type="link">Email</a>
    </nav>

    <button class="btn btn--line footer__share" type="button" data-share data-copied={t['footer.copied']}>
      {shareLabel}
    </button>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-share]');
  button?.addEventListener('click', async () => {
    const shareData = {
      title: document.title,
      text: document.querySelector('meta[name="description"]')?.getAttribute('content') ?? '',
      url: window.location.href,
    };
    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch {
        /* cancelled */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(window.location.href);
      button.textContent = button.dataset.copied ?? 'Link copied';
    } catch {
      /* clipboard unavailable */
    }
  });
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    padding-block: 3rem 6rem;
  }

  .footer__inner {
    display: grid;
    gap: 1.8rem;
  }

  .footer__brand :global(.brand) {
    margin-bottom: 0.65rem;
  }

  .footer__tagline {
    color: var(--sage);
    font-size: var(--text-small);
  }

  .footer__hand {
    margin-top: 0.3rem;
    font-size: 1.7rem;
    color: var(--sage);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .footer__heading {
    color: var(--sage);
    margin-bottom: 0.35rem;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--sr-piedra);
  }

  .footer__col a:hover {
    text-decoration-color: var(--paper);
  }

  .footer__share {
    justify-self: start;
    border-color: var(--paper);
    color: var(--paper);
  }

  .footer__share:hover {
    background: rgba(242, 228, 202, 0.08);
  }

  @media (min-width: 800px) {
    .footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr auto;
      align-items: start;
    }
  }
</style>
