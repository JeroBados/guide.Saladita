---
interface Props {
  question: string;
  labels: {
    eat: string;
    surf: string;
    move: string;
    relax: string;
    tips: string;
  };
}

const { question, labels } = Astro.props;

const chips = [
  { id: 'eat', label: labels.eat },
  { id: 'surf', label: labels.surf },
  { id: 'move', label: labels.move },
  { id: 'relax', label: labels.relax },
  { id: 'tips', label: labels.tips },
] as const;
---

<nav class="intent-chips" aria-label={question}>
  <div class="intent-chips__inner container">
    <p class="intent-chips__question">{question}</p>
    <div class="intent-chips__list" role="list">
      {
        chips.map((chip) => (
          <button
            class="intent-chips__chip"
            type="button"
            role="listitem"
            data-filter-chip={chip.id}
            aria-pressed="false"
          >
            {chip.label}
          </button>
        ))
      }
    </div>
  </div>
</nav>

<script>
  const chipButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-chip]'));
  let activeChip: string | null = null;

  function applyFilter(chip: string | null) {
    const update = () => {
      document.querySelectorAll<HTMLElement>('[data-chip]').forEach((el) => {
        const hidden = chip !== null && el.dataset.chip !== chip;
        el.classList.toggle('filter-hidden', hidden);
        el.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      });

      document.querySelectorAll<HTMLElement>('[data-section]').forEach((section) => {
        const hidden = chip !== null && section.dataset.section !== chip;
        section.classList.toggle('filter-hidden', hidden);
        section.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      });

      document.querySelectorAll<HTMLElement>('[data-section-chip]').forEach((section) => {
        if (chip === null) {
          section.classList.remove('filter-hidden');
          section.removeAttribute('aria-hidden');
          return;
        }

        const hidden = section.dataset.sectionChip !== chip;
        section.classList.toggle('filter-hidden', hidden);
        section.setAttribute('aria-hidden', hidden ? 'true' : 'false');
      });

      document.querySelectorAll<HTMLElement>('.section:not([data-section]):not(.map-section)').forEach((section) => {
        if (chip === null) {
          section.classList.remove('filter-hidden');
          section.removeAttribute('aria-hidden');
          return;
        }

        const hasMatch = section.querySelector(`[data-chip="${chip}"]`) !== null;
        section.classList.toggle('filter-hidden', !hasMatch);
        section.setAttribute('aria-hidden', hasMatch ? 'false' : 'true');
      });

      window.dispatchEvent(new CustomEvent('chip-filter', { detail: { chip } }));
    };

    if ('startViewTransition' in document) {
      (document as Document & { startViewTransition: (cb: () => void) => void }).startViewTransition(update);
    } else {
      update();
    }
  }

  chipButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.filterChip ?? null;

      if (activeChip === value) {
        activeChip = null;
        chipButtons.forEach((chip) => {
          chip.classList.remove('is-active');
          chip.setAttribute('aria-pressed', 'false');
        });
      } else {
        activeChip = value;
        chipButtons.forEach((chip) => {
          const isActive = chip.dataset.filterChip === value;
          chip.classList.toggle('is-active', isActive);
          chip.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      applyFilter(activeChip);
    });
  });
</script>

<style>
  .intent-chips {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(240, 237, 230, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(148, 137, 121, 0.25);
  }

  .intent-chips__inner {
    display: grid;
    gap: 0.85rem;
    padding-block: 1rem;
  }

  .intent-chips__question {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--taupe);
  }

  .intent-chips__list {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: none;
  }

  .intent-chips__list::-webkit-scrollbar {
    display: none;
  }

  .intent-chips__chip {
    flex: 0 0 auto;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-chip);
    border: 1px solid var(--taupe);
    background: transparent;
    color: var(--navy);
    font-size: var(--text-small);
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .intent-chips__chip.is-active {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--cream);
  }

  .intent-chips__chip:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }
</style>
