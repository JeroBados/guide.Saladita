---
interface Props {
  title: string;
  hint: string;
  checkInLabel: string;
  checkOutLabel: string;
  cta: string;
  message: string;
  error: string;
}

const { title, hint, checkInLabel, checkOutLabel, cta, message, error } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
---

<div class="book-stay reveal">
  <h3 class="book-stay__title">{title}</h3>
  <p class="book-stay__hint">{hint}</p>

  <form class="book-stay__form" data-book-form>
    <div class="book-stay__fields">
      <label class="book-stay__field">
        <span>{checkInLabel}</span>
        <input type="date" name="checkin" min={today} required />
      </label>
      <label class="book-stay__field">
        <span>{checkOutLabel}</span>
        <input type="date" name="checkout" min={today} required />
      </label>
    </div>
    <button class="book-stay__cta" type="submit">{cta}</button>
    <p class="book-stay__error" data-book-error hidden role="alert"></p>
  </form>
</div>

<script type="application/json" id="book-stay-config" set:html={JSON.stringify({ template: message, error })} />

<script>
  function bindBookStayForm() {
    const form = document.querySelector('[data-book-form]');
    const configEl = document.getElementById('book-stay-config');
    if (!form || !configEl) return;

    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    let template = '';
    let errorText = '';
    try {
      const config = JSON.parse(configEl.textContent || '{}');
      template = config.template || '';
      errorText = config.error || '';
    } catch {
      return;
    }

    const errorEl = form.querySelector('[data-book-error]');
    const checkinInput = form.querySelector('[name="checkin"]');
    const checkoutInput = form.querySelector('[name="checkout"]');

    function showError(msg: string) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
    }

    checkinInput?.addEventListener('change', () => {
      if (checkoutInput && checkinInput.value) {
        checkoutInput.min = checkinInput.value;
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const checkin = String(data.get('checkin') || '');
      const checkout = String(data.get('checkout') || '');
      if (!checkin || !checkout || checkout <= checkin) {
        showError(errorText);
        return;
      }

      showError('');
      const text = template.replaceAll('{checkin}', checkin).replaceAll('{checkout}', checkout);
      const url = `https://wa.me/525611073849?text=${encodeURIComponent(text)}`;

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'cta_click', { place: 'book-stay', type: 'whatsapp' });
      }

      window.location.href = url;
    });
  }

  bindBookStayForm();
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector('[data-book-form]');
    if (form) form.dataset.bound = 'false';
    bindBookStayForm();
  });
</script>

<style>
  .book-stay {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid rgba(148, 137, 121, 0.25);
  }

  .book-stay__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--navy);
  }

  .book-stay__hint {
    font-size: var(--text-small);
    color: var(--taupe);
    max-width: 36rem;
  }

  .book-stay__form {
    display: grid;
    gap: 0.85rem;
  }

  .book-stay__fields {
    display: grid;
    gap: 0.65rem;
  }

  .book-stay__field {
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-small);
    color: var(--navy);
  }

  .book-stay__field input {
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(148, 137, 121, 0.4);
    border-radius: 12px;
    background: #fff;
    color: var(--navy);
    font: inherit;
  }

  .book-stay__cta {
    justify-self: start;
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-chip);
    background: var(--navy);
    color: var(--cream);
    font-weight: 700;
    font-size: var(--text-small);
    transition: transform var(--dur) var(--ease-out);
  }

  .book-stay__cta:active {
    transform: scale(0.98);
  }

  .book-stay__error {
    font-size: var(--text-small);
    color: #b54a3a;
  }

  @media (min-width: 640px) {
    .book-stay__fields {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
