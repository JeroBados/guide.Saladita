---
import LangToggle from './LangToggle.astro';
import Sketch from './Sketch.astro';
import { buildWhatsAppUrl } from '../utils/wa';
import type { Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
  altPath: string;
  t: Record<string, string>;
}

const { lang, altPath, t } = Astro.props;
const helpUrl = buildWhatsAppUrl(t['wa.floating']);

const facts = [
  { icon: 'plane', text: t['facts.airport'] },
  { icon: 'wave', text: t['facts.wave'] },
  { icon: 'drop', text: t['facts.water'] },
  { icon: 'cash', text: t['facts.cash'] },
  { icon: 'signal', text: t['facts.signal'] },
] as const;
---

<header class="topbar container">
  <a class="topbar__brand" href={lang === 'en' ? '/' : '/es/'} aria-label="Saladita Rentals — guide home">
    <img src="/logo.png" alt="" width="44" height="44" />
    <span>Saladita Rentals<small>{t['topbar.guide']}</small></span>
  </a>
  <LangToggle lang={lang} altPath={altPath} label={t['nav.lang']} />
</header>

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="hero__kicker hand hero-fade-in">
      {t['hero.eyebrow']}
      <Sketch name="arrow" class="hero__kicker-arrow" />
    </p>
    <h1 id="hero-title" class="hero__title hero-fade-in" style="--delay: 1">
      <span class="hero__line">{t['hero.titleLine1']}</span>
      <span class="hero__place">
        <em>{t['hero.titleLine2']}</em>
        <Sketch name="swoosh" class="hero__swoosh" />
      </span>
    </h1>
    <p class="hero__sub hero-fade-in" style="--delay: 2">{t['hero.sub']}</p>
    <div class="hero__actions hero-fade-in" style="--delay: 3">
      <a class="btn btn--ink" href={helpUrl} target="_blank" rel="noopener noreferrer" data-track-cta data-place-id="hero-whatsapp" data-cta-type="whatsapp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9A11.8 11.8 0 0 0 12.05 0Zm0 21.8a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.9 9.9 0 1 1 8.37 4.63Zm5.42-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35Z"/></svg>
        {t['hero.helpCta']}
      </a>
      <span class="hand hero__help-note">{t['hero.helpNote']}</span>
    </div>
    <p class="hero__updated hero-fade-in" style="--delay: 4">{t['hero.updated']}</p>
  </div>

  <figure class="polaroid hero-fade-in" style="--delay: 2">
    <span class="tape tape--tl" aria-hidden="true"></span>
    <span class="tape tape--br" aria-hidden="true"></span>
    <img src="/media/hero.jpg" alt={t['hero.photoAlt']} width="1920" height="1080" fetchpriority="high" decoding="async" />
    <figcaption class="hand">{t['hero.caption']}</figcaption>
  </figure>

  <span class="hero__palm float-draw" aria-hidden="true"><Sketch name="palm" /></span>
</section>

<aside class="facts container" aria-labelledby="facts-title">
  <div class="facts__card">
    <h2 id="facts-title" class="facts__title hand">{t['facts.title']}</h2>
    <ul>
      {
        facts.map((f) => (
          <li>
            <Sketch name={f.icon} />
            <span set:html={f.text} />
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem 0.5rem;
  }

  .topbar__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.1;
  }

  .topbar__brand img {
    width: 44px;
    height: 44px;
    filter: brightness(0.62) saturate(1.1);
  }

  .topbar__brand small {
    display: block;
    font-family: var(--font-hand);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--pencil);
  }

  .hero {
    position: relative;
    display: grid;
    gap: 2.25rem;
    padding-block: 1.75rem 2.5rem;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.25rem;
    transform: rotate(-2deg);
    margin-bottom: 0.4rem;
  }

  .hero__kicker :global(.hero__kicker-arrow) {
    width: 2.6rem;
    margin-top: 0.6rem;
    transform: rotate(8deg);
  }

  .hero__title {
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-bottom: 1.1rem;
  }

  .hero__line {
    display: block;
  }

  .hero__place {
    position: relative;
    display: inline-block;
  }

  .hero__place em {
    position: relative;
    z-index: 1;
  }

  .hero__place :global(.hero__swoosh) {
    position: absolute;
    left: -2%;
    bottom: -0.12em;
    width: 104%;
    color: var(--taupe);
  }

  .hero__place :global(.hero__swoosh .sketch__line) {
    stroke-width: 3;
    animation-delay: 0.9s;
  }

  .hero__sub {
    font-size: 1.125rem;
    max-width: 34ch;
    margin-bottom: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .hero__help-note {
    font-size: 1.3rem;
    transform: rotate(-3deg);
  }

  .hero__updated {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--pencil);
  }

  .polaroid {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem);
    padding: 0.7rem 0.7rem 0;
    background: var(--paper-3);
    box-shadow: var(--shadow-lift);
    transform: rotate(2.2deg);
  }

  .polaroid img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    object-position: center 30%;
    filter: saturate(0.88) contrast(1.02) sepia(0.08);
  }

  .polaroid figcaption {
    padding: 0.45rem 0.2rem 0.6rem;
    font-size: 1.4rem;
    text-align: center;
  }

  .tape--tl {
    top: -0.7rem;
    left: -1rem;
    transform: rotate(-24deg);
  }

  .tape--br {
    bottom: 1.2rem;
    right: -0.9rem;
    transform: rotate(-28deg);
  }

  .hero__palm {
    position: absolute;
    right: 0;
    top: -0.5rem;
    width: 4.5rem;
    color: var(--ink-2);
    opacity: 0.8;
    pointer-events: none;
  }

  .hero__palm :global(.sketch) {
    width: 100%;
  }

  /* Short version */
  .facts {
    padding-bottom: 1rem;
  }

  .facts__card {
    position: relative;
    padding: 1.25rem 1.25rem 1.1rem;
    background: var(--paper-3);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-hand);
    box-shadow: 4px 5px 0 var(--sand);
  }

  .facts__title {
    font-size: 1.7rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  .facts ul {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .facts li :global(.sketch) {
    width: 2.4rem;
    color: var(--ink-2);
  }

  .facts li :global(strong) {
    font-weight: 700;
  }

  @media (min-width: 820px) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 3rem;
      padding-block: 3rem 3.5rem;
    }

    .hero__palm {
      display: none;
    }

    .facts ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }

    .facts li {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.3rem;
    }
  }
</style>
