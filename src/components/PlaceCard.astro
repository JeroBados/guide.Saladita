---
import type { Lang } from '../utils/i18n';
import type { Place } from '../types/place';
import { getCtaLabel, getCtaUrl } from '../utils/wa';
import Sketch from './Sketch.astro';

interface Props {
  place: Place;
  lang: Lang;
  directionsLabel: string;
  whatsappLabel: string;
}

const { place, lang, directionsLabel, whatsappLabel } = Astro.props;
const ctaUrl = getCtaUrl(place, lang);
const ctaLabel = getCtaLabel(place, lang, { directions: directionsLabel, whatsapp: whatsappLabel });
---

<article class="place-card" data-chip={place.chip} data-place-id={place.id} id={place.id}>
  <span class="tape place-card__tape" aria-hidden="true"></span>
  <Sketch name="shell" class="place-card__draw" />
  <h3 class="place-card__name">{place.name}</h3>
  <p class="place-card__badge hand">{place.badge[lang]}</p>
  <p class="place-card__desc">{place.desc[lang]}</p>
  {place.note && <p class="place-card__note">{place.note[lang]}</p>}
  {
    ctaUrl && (
      <a
        class="pen-link place-card__cta"
        href={ctaUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-cta
        data-place-id={place.id}
        data-cta-type={place.cta.type}
      >
        {ctaLabel} →
      </a>
    )
  }
</article>

<style>
  .place-card {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 1.5rem 1.2rem 0.8rem;
    background: var(--paper-3);
    border: 1px solid rgba(21, 52, 72, 0.1);
    box-shadow: var(--shadow-paper);
    transform: rotate(-0.5deg);
  }

  .place-card__tape {
    top: -0.7rem;
    left: 1rem;
    transform: rotate(-5deg);
  }

  .place-card :global(.place-card__draw) {
    width: 2.8rem;
    color: var(--ink-2);
  }

  .place-card__name {
    font-size: 1.4rem;
  }

  .place-card__badge {
    font-size: 1.25rem;
  }

  .place-card__note {
    font-size: 0.9rem;
    color: var(--pencil);
    font-style: italic;
  }

  .place-card__cta {
    justify-self: start;
    font-size: 0.92rem;
  }
</style>
